#
# Experimental legacy BIOS PC board.
#
architecture    "i386"
cpu             "I686"
board           "PC"

options         "CONS_MAJOR=0", "CONS_MINOR=0"

service         dma
service         disk
service         usb
service         umass
service         uhub
service         ukbd
service         pc
service         ehci
service         ohci
service         uhci

config          unix    root on major 0 minor 0
                        swap none
