#
# Experimental legacy BIOS PC board.
#
architecture    "i386"
cpu             "I686"
board           "PC"

options         "CONS_MAJOR=0", "CONS_MINOR=0"
options         "I386_FPU_ENABLED"

service         "i386_rtc"
service         dma
service         disk
service         "i8042"
service         usb
service         umass
service         uhub
service         ukbd
service         ums
service         pc
service         ether   1
service         "rtl8169"
service         inet
service         ehci
service         ohci
service         uhci

config          unix    root on major 0 minor 0
                        swap none
