# The early Makefile directly links vm_param, vm_phys and vm_page so the
# allocator can be validated before the full kernel configuration is enabled.
# vm_map/vm_object/vmspace, i386 copy I/O, the u-area allocator, context
# switch, fork/init frames, ring-3/TSS, int 0x80 ABI, production-numbered
# sysent bootstrap prefix, i386 signal frame, user-return work loop and
# generic process table/process 1 with its persistent CPL3
# production-syscall probe, common UFS-root-backed ELF32 /sbin/init and
# exec-compatible user stack are linked by the early Makefile together with
# user trap-to-signal translation, generic kern_synch run queue/scheduler
# and generic newproc with production fork syscall.  Read-only
# open/read/lseek/close use the common VFS and descriptor paths, including
# shared offsets across fork and early exit teardown.  The embedded UFS root
# is exposed by the common read-only romdisk block driver at major 0 minor 0.
# Remaining machine-independent files are connected as the diagnostic
# bootstrap is replaced by normal common startup.
kernel/cons.c                   standard
kernel/subr_dma.c               optional dma
disk/disk_subr.c                optional disk
disk/disk.c                     optional disk
disk/romdisk.c                  standard
usb/usb_subr.c                  optional usb
usb/usb_core.c                  optional usb
usb/usb_service.c               optional usb
usb/usb_task.c                  optional usb
usb/uhub.c                      optional uhub
usb/ukbdmap.c                   optional ukbd
usb/ukbd.c                      optional ukbd
usb/ehci.c                      optional ehci
usb/ohci.c                      optional ohci
usb/umass_bbb.c                 optional umass
usb/umass.c                     optional umass
i386/pc/dma.c                   optional dma
i386/pc/usb_pci.c               optional usb ehci ohci
i386/pc/romdisk.c               standard
