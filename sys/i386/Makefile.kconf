# Declarative inventory-check template for the legacy BIOS i686 port.
#
# sys/i386/Makefile remains the canonical image builder because it also owns
# the BIOS setup payload, embedded UFS image and reproducible userland/PCC
# pipeline.  kconfig owns service selection plus ioconf.c/swapunix.c and this
# generated makefile proves that every selected, non-generated kernel source
# named by files.kconf exists.  It is intentionally not a second link path.

TOPSRC ?= ../../..
S = $(TOPSRC)/sys

%OBJS

%CFILES

ASMFILES = \
	$(S)/i386/boot/entry.S \
	$(S)/i386/boot/interrupt_entry.S \
	$(S)/i386/common/context.S \
	$(S)/i386/common/privilege.S

INVENTORY_FILES = $(CFILES) $(ASMFILES)

.PHONY: all inventory
all: inventory

inventory: $(INVENTORY_FILES)
	@echo "i386 kconfig inventory: $$(echo $(INVENTORY_FILES) | wc -w | tr -d ' ') sources ok"
