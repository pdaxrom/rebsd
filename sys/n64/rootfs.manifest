#
# Minimal read-only cartridge root filesystem for the N64 port.
#
default
owner 0
group 0
dirmode 0775
filemode 0664

dir /bin
dir /dev
dir /etc
dir /root
dir /sbin
dir /share
dir /share/man
dir /share/man/cat1
dir /share/man/cat8
dir /share/misc
dir /tmp
dir /var
dir /var/log
dir /var/run

file /.profile

file /etc/motd

file /etc/profile

file /etc/rc
mode 0775

file /etc/fstab

file /etc/ttys

file /root/.profile

file /bin/sh
mode 0775

file /bin/cat
mode 0775

file /bin/chmod
mode 0775

file /bin/cp
mode 0775

file /bin/echo
mode 0775

file /bin/env
mode 0775

file /bin/groups
mode 0775

file /bin/hostname
mode 0775

file /bin/id
mode 0775

file /bin/kill
mode 0775

file /bin/ls
mode 0775

file /bin/man
mode 0775

file /bin/mkdir
mode 0775

file /bin/more
mode 0775

file /bin/mv
mode 0775

file /bin/pwd
mode 0775

file /bin/rm
mode 0775

file /bin/rmdir
mode 0775

file /bin/sleep
mode 0775

file /bin/stty
mode 0775

file /bin/test
mode 0775

file /bin/[
mode 0775

file /bin/uname
mode 0775

file /bin/whoami
mode 0775

file /share/misc/more.help

file /share/man/cat1/groups.0

file /share/man/cat1/hostname.0

file /share/man/cat1/id.0

file /share/man/cat1/stty.0

file /share/man/cat1/test.0

file /share/man/cat1/uname.0

file /share/man/cat1/whoami.0

file /share/man/cat8/chown.0

file /share/man/cat8/init.0

file /share/man/cat8/mount.0

file /share/man/cat8/reboot.0

file /share/man/cat8/umount.0

file /sbin/chown
mode 0775

file /sbin/fsck
mode 0775

file /sbin/init
mode 0775

file /sbin/mount
mode 0775

file /sbin/reboot
mode 0775

file /sbin/umount
mode 0775
