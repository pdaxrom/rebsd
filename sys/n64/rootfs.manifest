#
# Minimal read-only cartridge root filesystem for the N64 port.
#
default
owner 0
group 0
dirmode 0775
filemode 0664

dir /bin
dir /dev
dir /etc
dir /root
dir /sbin
dir /tmp
dir /var
dir /var/log
dir /var/run

file /etc/motd

file /etc/rc
mode 0775

file /etc/ttys

file /root/.profile

file /bin/sh
mode 0775

file /bin/ls
mode 0775

file /sbin/init
mode 0775
