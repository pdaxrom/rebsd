#
# Malta-specific rootfs additions.  Shared MIPS userland layout comes from
# sys/mips/rootfs.manifest; this file only describes Malta device nodes.
#

bdev /dev/romdisk
major 0
minor 0

bdev /dev/ram0
major 1
minor 0

bdev /dev/ram1
major 1
minor 1

bdev /dev/ram2
major 1
minor 2

bdev /dev/ram3
major 1
minor 3

cdev /dev/console
major 0
minor 0

cdev /dev/mem
major 1
minor 0
mode 0640

cdev /dev/kmem
major 1
minor 1
mode 0640

cdev /dev/cartflash0
major 11
minor 0
mode 0600

cdev /dev/null
major 1
minor 2
mode 0666

cdev /dev/zero
major 1
minor 3
mode 0666

cdev /dev/tty
major 2
minor 0

cdev /dev/ttyS0
major 3
minor 0

cdev /dev/ttyp0
major 8
minor 0
mode 0666

cdev /dev/ttyp1
major 8
minor 1
mode 0666

cdev /dev/ttyp2
major 8
minor 2
mode 0666

cdev /dev/ttyp3
major 8
minor 3
mode 0666

cdev /dev/ptyp0
major 9
minor 0
mode 0666

cdev /dev/ptyp1
major 9
minor 1
mode 0666

cdev /dev/ptyp2
major 9
minor 2
mode 0666

cdev /dev/ptyp3
major 9
minor 3
mode 0666
