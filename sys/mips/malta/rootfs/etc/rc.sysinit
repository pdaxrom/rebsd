#!/bin/sh
HOME=/; export HOME
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH
PAGER=/bin/cat; export PAGER
. /etc/rc.status
. /etc/rc.storage

if ! rc_run 'hostname' /bin/hostname malta; then
	exit 1
fi

physmem=`/usr/bin/sysctl -n hw.physmem`
# The full Malta image reserves 32M for the embedded root filesystem.  Keep
# the default contiguous RAM backing below the remaining VM run; the 2x media
# size is provided by compression and is not part of this physical budget.
if test "$physmem" -le 8388608; then
        swap_backing=1792K
elif test "$physmem" -le 33554432; then
        swap_backing=6M
else
        swap_backing=16M
fi

if ! rc_var_setup /dev/ram0 1M 4096; then
	exit 1
fi

if ! rc_compressed_swap_setup /dev/ram1 "$swap_backing" 2x; then
	exit 1
fi

exit 0
