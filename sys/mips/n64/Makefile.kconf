N64_LINPACK_GCC_RUNTIME_DIR = n64-linpack-gcc-runtime.$(N64_USERLAND_ABI)
N64_LINPACK_GCC_RUNTIME_TREE = $(N64_LINPACK_GCC_RUNTIME_DIR)/tree
N64_LINPACK_GCC_RUNTIME_STAMP = $(N64_LINPACK_GCC_RUNTIME_DIR)/.built
N64_LINPACK_GCC_RUNTIME_CC = N64_AOUT_TOPSRC=$(abspath $(N64_LINPACK_GCC_RUNTIME_TREE)) \
    N64_AOUT_AS=$(abspath $(MIPS_NATIVE_AS)) N64_PREFIX=$(N64_PREFIX) \
    N64_AOUT_CPU=$(N64_USERLAND_CPU) N64_AOUT_FLOAT=$(N64_USERLAND_FLOAT) \
    $(abspath $(MIPS_NATIVE_CC_SCRIPT)) \
    -I$(abspath $(N64_LINPACK_GCC_RUNTIME_TREE)/sys/mips/include)
MIPS_LINPACK_GCC_COMPILE = N64_AOUT_TOPSRC=$(abspath $(TOPSRC)) \
    N64_AOUT_AS=$(abspath $(MIPS_NATIVE_AS)) N64_PREFIX=$(N64_PREFIX) \
    N64_AOUT_CPU=$(N64_USERLAND_CPU) N64_AOUT_FLOAT=$(N64_USERLAND_FLOAT) \
    $(abspath $(MIPS_NATIVE_CC_SCRIPT))
MIPS_LINPACK_GCC_LINK = $(MIPS_NATIVE_LD) -X -d -e _start \
    $(abspath $(N64_LINPACK_GCC_RUNTIME_DIR)/crt0.o)
MIPS_LINPACK_GCC_LIBDIR = $(abspath $(N64_LINPACK_GCC_RUNTIME_DIR))
MIPS_LINPACK_GCC_LINK_FORMAT = aout
MIPS_LINPACK_GCC_DEPS = $(N64_LINPACK_GCC_RUNTIME_STAMP)
endif
MIPS_ROOTFS_TARGET_PLATFORM = n64
