	AR="$(abspath $(MIPS_NATIVE_AOUT_AR))" \
	RANLIB="$(abspath $(MIPS_NATIVE_AOUT_RANLIB))"

$(N64_LINPACK_GCC_RUNTIME_STAMP): $(MIPS_NATIVE_CRT0_SRC) \
    $(MIPS_LIBC_SRCS) $(MIPS_LIBM_SRCS) $(MIPS_INCLUDE_SRCS) \
    $(MIPS_NATIVE_CC_SCRIPT) $(MIPS_NATIVE_AS) $(MIPS_NATIVE_LD) \
    $(MIPS_NATIVE_AOUT_AR) $(MIPS_NATIVE_AOUT_RANLIB) \
    $(TOPSRC)/target.mk $(TOPSRC)/target-mips.mk $(TOPSRC)/target-n64.mk
	rm -rf $(N64_LINPACK_GCC_RUNTIME_DIR)
	mkdir -p $(N64_LINPACK_GCC_RUNTIME_TREE)/src \
	    $(N64_LINPACK_GCC_RUNTIME_TREE)/sys/mips/n64
	cp -pR $(TOPSRC)/include $(N64_LINPACK_GCC_RUNTIME_TREE)/
	cp -pR $(TOPSRC)/sys/include $(N64_LINPACK_GCC_RUNTIME_TREE)/sys/
	cp -p $(TOPSRC)/sys/mips/*.h \
	    $(N64_LINPACK_GCC_RUNTIME_TREE)/sys/mips/
	cp -p $(TOPSRC)/sys/mips/n64/*.h \
	    $(N64_LINPACK_GCC_RUNTIME_TREE)/sys/mips/n64/
	cp -pR $(TOPSRC)/sys/mips/n64/include \
	    $(N64_LINPACK_GCC_RUNTIME_TREE)/sys/mips/n64/
	cp -pR $(TOPSRC)/src/libc $(TOPSRC)/src/libm \
	    $(N64_LINPACK_GCC_RUNTIME_TREE)/src/
	cp -p $(TOPSRC)/target.mk $(TOPSRC)/target-mips.mk \
	    $(TOPSRC)/target-n64.mk $(N64_LINPACK_GCC_RUNTIME_TREE)/
	$(N64_LINPACK_GCC_RUNTIME_CC) -x assembler-with-cpp -c \
	    -o $(N64_LINPACK_GCC_RUNTIME_DIR)/crt0.o $(MIPS_NATIVE_CRT0_SRC)
	$(N64_LINPACK_GCC_LIBC_MAKE) clean
	$(N64_LINPACK_GCC_LIBC_MAKE) all
	$(MIPS_NATIVE_AOUT_RANLIB) $(N64_LINPACK_GCC_RUNTIME_TREE)/src/libc.a
	$(N64_LINPACK_GCC_LIBM_MAKE) clean
	$(N64_LINPACK_GCC_LIBM_MAKE) all
	cp -p $(N64_LINPACK_GCC_RUNTIME_TREE)/src/libc.a \
	    $(N64_LINPACK_GCC_RUNTIME_TREE)/src/libm.a \
	    $(N64_LINPACK_GCC_RUNTIME_DIR)/
	touch $@
endif
N64_STAGE0_CONSOLE_OBJS = $(if $(filter n64cart_uart.o,$(OBJS)),stage0_n64cart_uart.o,stage0_console_null.o)
N64_STAGE0_OBJS = stage0.o stage0_loader.o $(N64_STAGE0_CONSOLE_OBJS)
N64_PREFLIGHT_CONSOLE_OBJS = $(if $(filter n64cart_uart.o,$(OBJS)),preflight_n64cart_uart.o,console_null.o)
N64_PREFLIGHT_OBJS = preflight_startup.o $(N64_PREFLIGHT_CONSOLE_OBJS) \
                     n64pi.o rompak.o memory.o preflight.o
N64_KERNEL_LDSCRIPT = n64.ld
N64_USER_LDSCRIPT = n64-user.ld

CC              = $(N64_PREFIX)gcc $(N64_KERNEL_ARCH) $(N64_KERNEL_CODE)
AS              = $(N64_PREFIX)gcc $(N64_KERNEL_ARCH) $(N64_KERNEL_CODE)
ASFPU           = $(N64_PREFIX)gcc $(N64_KERNEL_ARCH) $(N64_FPU_CODE)
LD              = $(N64_PREFIX)ld -m elf32ebmip
OBJDUMP         = $(N64_PREFIX)objdump
OBJCOPY         = $(N64_PREFIX)objcopy
SIZE            = $(N64_PREFIX)size
STRIP           = $(N64_PREFIX)strip
NM              = $(N64_PREFIX)nm
N64_TOOL        = $(N64_TOOLCHAIN)/bin/n64tool
FSUTIL          = $(OBJTOP)/tools/fsutil/fsutil
ELF2AOUT        = $(OBJTOP)/tools/elf2aout/elf2aout

DEPFLAGS        = -MT $@ -MP -MD -MF .deps/$*.dep
CPPFLAGS        = -I. -I$(TOPSRC)/include -I$(TOPSRC)/sys \
                  ${PARAM} -DKERNEL -DN64 -DMIPS \
                  -DHW_MACHINE_NAME='"$(SYSTEM_TARGET)"' \
                  -DHW_MODEL_NAME='"NEC VR4300"'
ifneq ($(filter -DINET_ENABLED,$(PARAM)),)
CPPFLAGS        += -I$(TOPSRC)/include/sys \
                  -I$(TOPSRC)/sys/net \
                  -I$(TOPSRC)/sys/netinet -DINET -DSUPERVISOR
INET_CWARN      = -Wno-comment -Wno-endif-labels -Wno-implicit-int \
                  -Wno-implicit-function-declaration -Wno-parentheses \
                  -Wno-return-mismatch -Wno-return-type
endif
ifneq ($(filter -DUNIXDOMAIN_ENABLED,$(PARAM)),)
CPPFLAGS        += -DUNIXDOMAIN
endif
ifeq ($(N64_TRACE),1)
CPPFLAGS        += -DN64_TRACE
endif
ifeq ($(VM_DIAGNOSTIC),1)
CPPFLAGS        += -DVM_DIAGNOSTIC
endif
ifeq ($(N64_ENABLE_ROMFS),1)
CPPFLAGS        += -DROMFS_ENABLED
endif
DEFS            = $(CPPFLAGS) $(DEPFLAGS)
CFLAGS          = -O2 -Wall -Werror -Wno-array-bounds -nostdinc $(DEFS) $(INET_CWARN)
VERS_CFLAGS     = -O2 -Wall -Werror -Wno-array-bounds -nostdinc $(CPPFLAGS)
ASFLAGS         = -x assembler-with-cpp -c $(DEFS)
FPU_ASFLAGS     = -x assembler-with-cpp -c $(DEFS)
ifeq ($(N64_USB_GDB),1)
# Keep source lines, types, and locals in the host-side unix.elf.  The ROM
# embeds a load-only unix.runtime.elf below, so debugger metadata does not
# make the image larger.
CFLAGS          += -g
VERS_CFLAGS     += -g
ASFLAGS         += -g
FPU_ASFLAGS     += -g
endif
STAGE0_CFLAGS   = $(N64_KERNEL_ARCH) $(N64_KERNEL_BASE) -msoft-float \
                  -ffreestanding -fno-builtin -fno-stack-protector \
                  -fno-pie -Wall -Wextra -Werror -O2 -MMD -MP $(PARAM)
STAGE0_ASFLAGS  = $(N64_KERNEL_ARCH) $(N64_KERNEL_BASE) -msoft-float \
                  -x assembler-with-cpp -MMD -MP -c $(PARAM)

KERNEL_CC       = ${CC}
KERNEL_AS       = $(N64_PREFIX)gcc $(N64_KERNEL_ARCH) $(N64_KERNEL_CODE) \
                  -x assembler -c
KERNEL_FPU_AS   = $(KERNEL_AS)
KERNEL_CPP_AS   = ${AS}
KERNEL_FPU_CPP_AS = ${ASFPU}
KERNEL_LD       = ${LD}
KERNEL_COMPILER_DEPS =
COMPILE_C       = ${KERNEL_CC} ${CFLAGS} -c $<
COMPILE_VERS_C  = ${KERNEL_CC} ${VERS_CFLAGS} -MT vers.o -MP -MD \
                  -MF .deps/vers.dep -c vers.c -o vers.o
REBSD_KERNEL_CPP_S = ${KERNEL_CC} -E -P -x assembler-with-cpp \
                     $(CPPFLAGS) $(DEPFLAGS) -o .deps/$(@:.o=.s) $<
ifeq ($(N64_KERNEL_COMPILER),pcc)
KERNEL_CC       = $(N64_HOST_PCC) -march=vr4300 -msoft-float \
                  -fomit-frame-pointer
KERNEL_AS       = $(N64_CROSS_PCC_AS) --elf -EB -march=vr4300 -O2
KERNEL_LD       = $(N64_CROSS_PCC_LD) --elf -EB
KERNEL_COMPILER_DEPS = $(MIPS_PCC_PROVIDER_DEPS) $(N64_CROSS_PCC_AS) \
                       $(N64_CROSS_PCC_LD)
KERNEL_CPP_AS   = $(KERNEL_CC)
KERNEL_FPU_CPP_AS = $(KERNEL_CC)
COMPILE_C       = ${KERNEL_CC} ${CFLAGS} -S -o .deps/$(@:.o=.s) $< && \
                  if grep -nE '^[[:space:]]*((add|sub|mul|div|sqrt|abs|mov|neg|cvt|trunc|round|floor|ceil|c\.[[:alnum:]_]+)\.(s|d|w|l)|(l|s)\.(s|d)|(lwc1|ldc1|swc1|sdc1|mfc1|mtc1|dmfc1|dmtc1|cfc1|ctc1|bc1[[:alnum:]_]*))[[:space:]]' .deps/$(@:.o=.s); then \
                      echo "error: PCC kernel C emitted COP1/FPU instructions in .deps/$(@:.o=.s)" >&2; exit 1; \
                  fi && \
                  ${KERNEL_AS} .deps/$(@:.o=.s) -o $@
COMPILE_VERS_C  = ${KERNEL_CC} ${VERS_CFLAGS} -MT vers.o -MP -MD \
                  -MF .deps/vers.dep -S -o .deps/vers.s vers.c && \
                  if grep -nE '^[[:space:]]*((add|sub|mul|div|sqrt|abs|mov|neg|cvt|trunc|round|floor|ceil|c\.[[:alnum:]_]+)\.(s|d|w|l)|(l|s)\.(s|d)|(lwc1|ldc1|swc1|sdc1|mfc1|mtc1|dmfc1|dmtc1|cfc1|ctc1|bc1[[:alnum:]_]*))[[:space:]]' .deps/vers.s; then \
                      echo "error: PCC kernel C emitted COP1/FPU instructions in .deps/vers.s" >&2; exit 1; \
                  fi && \
                  ${KERNEL_AS} .deps/vers.s -o vers.o
endif
SYSTEM_BUILD_USER ?= $(shell id -un 2>/dev/null || echo unknown)
SYSTEM_BUILD_HOST ?= $(shell hostname 2>/dev/null || uname -n 2>/dev/null || echo unknown)
SYSTEM_COMPILER_VERSION_gcc = $(shell $(firstword $(CC)) --version 2>/dev/null | sed -n '1p')
SYSTEM_COMPILER_VERSION_pcc = $(shell $(firstword $(N64_HOST_PCC)) -v 2>&1 | sed -n '/Portable C Compiler/{p;q;}')
SYSTEM_COMPILER_VERSION = $(or $(SYSTEM_COMPILER_VERSION_$(N64_KERNEL_COMPILER)),unknown)
SYSTEM_TOOLCHAIN_gcc = $(notdir $(firstword $(CC)))
SYSTEM_TOOLCHAIN_pcc = $(notdir $(firstword $(N64_HOST_PCC)))
SYSTEM_TOOLCHAIN = $(or $(SYSTEM_TOOLCHAIN_$(N64_KERNEL_COMPILER)),unknown)
SYSTEM_BUILD_NUMBER ?= $(or $(REBSD_BUILD_NUMBER),1)
SYSTEM_KERNEL_IDENT ?= GENERIC
SYSTEM_BUILD_DATE := $(or $(REBSD_BUILD_DATE),$(shell LC_ALL=C date '+%a %b %e %H:%M:%S %Z %Y'))
SYSTEM_GITREV := $(or $(shell git -C $(TOPSRC) rev-parse HEAD 2>/dev/null),unknown)
SYSTEM_GIT_BRANCH := $(or $(shell git -C $(TOPSRC) symbolic-ref --short -q HEAD 2>/dev/null),detached)
SYSTEM_GIT_DIRTY := $(shell test -n "$$(git -C $(TOPSRC) status --porcelain --untracked-files=normal 2>/dev/null)" && echo 1 || echo 0)
SYSTEM_TARGET = $(if $(filter little,$(N64_USERLAND_ENDIAN)),mipsel,mips)
VERSION_GENERATOR = $(TOPSRC)/tools/build/gen-vers.py
GENERATE_VERS = python3 $(VERSION_GENERATOR) --output vers.c \
                  --version-header "$(TOPSRC)/sys/include/rebsd_version.h" \
                  --ident "$(SYSTEM_KERNEL_IDENT)" \
                  --build-number "$(SYSTEM_BUILD_NUMBER)" \
                  --build-date "$(SYSTEM_BUILD_DATE)" \
                  --compiler "$(N64_KERNEL_COMPILER)" \
                  --build-user "$(SYSTEM_BUILD_USER)" \
                  --build-host "$(SYSTEM_BUILD_HOST)" \
                  --toolchain "$(SYSTEM_TOOLCHAIN)" \
                  --toolchain-version "$(SYSTEM_COMPILER_VERSION)" \
                  --git-rev "$(SYSTEM_GITREV)" \
                  --git-branch "$(SYSTEM_GIT_BRANCH)" \
                  --dirty "$(SYSTEM_GIT_DIRTY)" \
                  --target "$(SYSTEM_TARGET)" \
                  --cpu "$(N64_USERLAND_CPU)" \
                  --fpu "$(N64_USERLAND_FLOAT)" \
                  --byteorder "$(N64_USERLAND_ENDIAN)"
COMPILE_S       = ${KERNEL_CPP_AS} ${ASFLAGS} $< -o $@
COMPILE_FPU_S   = ${KERNEL_FPU_CPP_AS} ${FPU_ASFLAGS} $< -o $@
ifeq ($(N64_KERNEL_COMPILER),pcc)
COMPILE_S       = ${REBSD_KERNEL_CPP_S} && ${KERNEL_AS} .deps/$(@:.o=.s) -o $@
COMPILE_FPU_S   = ${REBSD_KERNEL_CPP_S} && ${KERNEL_FPU_AS} .deps/$(@:.o=.s) -o $@
endif

%OBJS

%CFILES

ifeq ($(N64_USB_GDB),1)
OBJS := $(filter-out if_usbn.o n64usbnet_proto.o n64cart_usbnet.o \
    n64cart_usbecm.o,$(OBJS))
CFILES := $(filter-out \
    $S/mips/common/if_usbn.c \
    $S/mips/common/n64usbnet_proto.c \
    $S/mips/n64/n64cart_usbnet.c \
    $S/mips/n64/n64cart_usbecm.c,$(CFILES))
OBJS += n64gdb.o n64cart_usbgdb.o
CFILES += $(N64_BOARD_SRC)/n64gdb.c $(N64_BOARD_SRC)/n64cart_usbgdb.c
endif

ifeq ($(N64_RESET_DUMP),1)
OBJS += n64reset.o
CFILES += $(N64_BOARD_SRC)/n64reset.c
endif

ifeq ($(N64_DEBUG_UART_ONLY),1)
OBJS := $(filter-out drm.o drm_fb.o drm_fbmem.o video.o video_console.o si.o joybus.o \
    if_usbn.o n64usbnet_proto.o n64cart_usbnet.o n64cart_usbecm.o,$(OBJS))
CFILES := $(filter-out \
    $S/drm/drm.c \
    $S/drm/drm_fb.c \
    $S/drm/drm_fbmem.c \
    $S/mips/n64/video.c \
    $S/mips/n64/video_console.c \
    $S/mips/n64/si.c \
    $S/mips/n64/joybus.c \
    $S/mips/common/if_usbn.c \
    $S/mips/common/n64usbnet_proto.c \
    $S/mips/n64/n64cart_usbnet.c \
    $S/mips/n64/n64cart_usbecm.c,$(CFILES))
endif
ifeq ($(N64_MINIMAL_USBNET_DEBUG),1)
OBJS := $(filter-out drm.o drm_fb.o drm_fbmem.o video.o video_console.o si.o joybus.o,$(OBJS))
CFILES := $(filter-out \
    $S/drm/drm.c \
    $S/drm/drm_fb.c \
    $S/drm/drm_fbmem.c \
    $S/mips/n64/video.c \
    $S/mips/n64/video_console.c \
    $S/mips/n64/si.c \
    $S/mips/n64/joybus.c,$(CFILES))
endif
ifeq ($(N64_MINIMAL_UART_ONLY),1)
OBJS := $(filter-out tty_pty.o sys_socket.o uipc_domain.o uipc_mbuf.o \
    uipc_proto.o uipc_usrreq.o uipc_socket.o uipc_socket2.o \
    uipc_syscalls.o af.o if.o if_ether.o if_loop.o raw_cb.o \
    raw_usrreq.o route.o in.o in_pcb.o in_proto.o ip_icmp.o ip_input.o \
    ip_output.o raw_ip.o tcp_debug.o tcp_input.o tcp_output.o \
    tcp_subr.o tcp_timer.o tcp_usrreq.o udp_usrreq.o in_cksum.o \
    net_glue.o netinit.o n64cart_rgbled.o n64cart_flash.o \
    romfs_backend.o romfs_core.o romfs_vfs.o,$(OBJS))
CFILES := $(filter-out \
    $S/kernel/tty_pty.c \
    $S/kernel/sys_socket.c \
    $S/kernel/uipc_domain.c \
    $S/kernel/uipc_mbuf.c \
    $S/kernel/uipc_proto.c \
    $S/kernel/uipc_usrreq.c \
    $S/kernel/uipc_socket.c \
    $S/kernel/uipc_socket2.c \
    $S/kernel/uipc_syscalls.c \
    $S/net/af.c \
    $S/net/if.c \
    $S/net/if_ether.c \
    $S/net/if_loop.c \
    $S/net/raw_cb.c \
    $S/net/raw_usrreq.c \
    $S/net/route.c \
    $S/netinet/in.c \
    $S/netinet/in_pcb.c \
    $S/netinet/in_proto.c \
    $S/netinet/ip_icmp.c \
    $S/netinet/ip_input.c \
    $S/netinet/ip_output.c \
    $S/netinet/raw_ip.c \
    $S/netinet/tcp_debug.c \
    $S/netinet/tcp_input.c \
    $S/netinet/tcp_output.c \
    $S/netinet/tcp_subr.c \
    $S/netinet/tcp_timer.c \
    $S/netinet/tcp_usrreq.c \
    $S/netinet/udp_usrreq.c \
    $S/mips/common/in_cksum.c \
    $S/mips/common/net_glue.c \
    $S/mips/common/netinit.c \
    $S/mips/n64/n64cart_rgbled.c \
    $S/mips/n64/n64cart_flash.c \
    $S/mips/n64/romfs_backend.c \
    $S/mips/common/romfs_core.c \
    $S/mips/common/romfs_vfs.c,$(CFILES))
endif

PCC_KERNEL_RUNTIME_OBJS =
PCC_KERNEL_RUNTIME_SRCS =
ifeq ($(N64_KERNEL_COMPILER),pcc)
include $(TOPSRC)/sys/mips/pcc-kernel-runtime.mk
endif

SYSTEM_OBJ      = startup.o ${OBJS} $(N64_IOCONF).o \
                  $(PCC_KERNEL_RUNTIME_OBJS)
SYSTEM_DEP      = Makefile $(N64_IOCONF_SRC) $(N64_KERNEL_LDSCRIPT) \
                  $(TOPSRC)/sys/include/rebsd_version.h \
                  $(VERSION_GENERATOR) \
                  $(KERNEL_COMPILER_DEPS) $(PCC_KERNEL_RUNTIME_SRCS)
ifeq ($(N64_KERNEL_COMPILER),pcc)
SYSTEM_DEP      += $(N64_VR4300_HILO_CHECK) $(N64_ASYNC_EPILOGUE_CHECK) \
                  $(TOPSRC)/sys/mips/n64/native/check-vr4300-order.py \
                  $(TOPSRC)/sys/mips/n64/native/check-mips-elf-relocs.py
endif
SYSTEM_LD_HEAD  = $(GENERATE_VERS); \
                  ${COMPILE_VERS_C}; \
                  rm -f $@
N64_ELF_RELOC_CHECK_CMD =
ifeq ($(N64_KERNEL_COMPILER),pcc)
N64_ELF_RELOC_CHECK_CMD = $(N64_ELF_RELOC_CHECK) ${SYSTEM_OBJ} vers.o &&
endif
SYSTEM_LD       = $(N64_ELF_RELOC_CHECK_CMD) \
                  ${KERNEL_LD} -nostdlib -T $(N64_KERNEL_LDSCRIPT) ${SYSTEM_OBJ} vers.o -o $@
SYSTEM_LD_TAIL  = ${SIZE} $@; \
                  ${OBJDUMP} -z -d -S $@ > $(basename $@).dis; \
                  ${NM} -n $@ > $(basename $@).nm
ifeq ($(N64_KERNEL_COMPILER),pcc)
SYSTEM_LD_TAIL  += ; $(N64_VR4300_HILO_CHECK) $(basename $@).dis; \
                  $(N64_ASYNC_EPILOGUE_CHECK) $(basename $@).dis; \
                  ${OBJDUMP} -z -d ${SYSTEM_OBJ} vers.o > $(basename $@).objects.dis; \
                  $(N64_VR4300_ORDER_CHECK) $(basename $@).objects.dis
endif

.PHONY: vm-host-check kernel-objects
vm-host-check:
	$(MAKE) -C $(TOPSRC)/sys/tests/vm test

kernel-objects: $(SYSTEM_OBJ) swapunix.o

# Do not produce a kernel, filesystem, or ROM image from untested VM geometry.
# Order-only keeps an already valid image from being rebuilt just because the
# check itself is intentionally phony.
unix.elf rootfs.img preflight.z64 kernel.z64 pcc-debug.z64: | vm-host-check

all: unix kernel.z64 preflight.z64

%LOAD

preflight: $(N64_PREFLIGHT_OBJS)
	$(SIZE) $(N64_PREFLIGHT_OBJS)

$(N64_KERNEL_LDSCRIPT): $(N64_BOARD_SRC)/n64.ld.S $(N64_BOARD_SRC)/layout.h
	$(N64_PREFIX)gcc -E -P -undef -x c $< -o $@

preflight.elf: $(N64_PREFLIGHT_OBJS) $(N64_KERNEL_LDSCRIPT)
	$(LD) -nostdlib -T $(N64_KERNEL_LDSCRIPT) $(N64_PREFLIGHT_OBJS) -o $@
	$(SIZE) $@
	$(OBJDUMP) -d -S $@ > preflight.dis

stage0.o: $(N64_BOARD_SRC)/stage0.S | .deps
	$(N64_PREFIX)gcc $(STAGE0_ASFLAGS) $< -o $@

.PHONY: n64-stage0-build-date
n64-stage0-build-date:
	@:

# Recompile the loader for every ROM build so its UART banner identifies the
# exact image even when the object directory is reused.
stage0_loader.o: $(N64_BOARD_SRC)/stage0_loader.c n64-stage0-build-date | .deps
	$(N64_PREFIX)gcc $(STAGE0_CFLAGS) \
	    -DN64_ROM_BUILD_DATE='"$(SYSTEM_BUILD_DATE)"' \
	    -DN64_ROM_KERNEL_COMPILER='"$(N64_KERNEL_COMPILER)"' \
	    -DN64_ROM_USERLAND_COMPILER='"$(N64_USERLAND_COMPILER)"' \
	    -c $< -o $@

stage0_console_null.o: $(N64_BOARD_SRC)/stage0_console_null.c $(N64_BOARD_SRC)/stage0_console.h | .deps
	$(N64_PREFIX)gcc $(STAGE0_CFLAGS) -c $< -o $@

stage0_n64cart_uart.o: $(N64_BOARD_SRC)/stage0_n64cart_uart.c $(N64_BOARD_SRC)/stage0_console.h $(N64_BOARD_SRC)/n64cart_uart.h | .deps
	$(N64_PREFIX)gcc $(STAGE0_CFLAGS) -c $< -o $@

stage0_kernel_blob.o: $(N64_BOARD_SRC)/stage0_kernel_blob.S preflight.elf | .deps
	$(N64_PREFIX)gcc $(STAGE0_ASFLAGS) -DN64_KERNEL_ELF=\"$(abspath preflight.elf)\" $< -o $@

unix.runtime.elf: unix.elf
	$(OBJCOPY) --strip-all $< $@

kernel_stage0_kernel_blob.o: $(N64_BOARD_SRC)/stage0_kernel_blob.S unix.runtime.elf | .deps
	$(N64_PREFIX)gcc $(STAGE0_ASFLAGS) -DN64_KERNEL_ELF=\"$(abspath unix.runtime.elf)\" $< -o $@

stage0.elf: $(N64_STAGE0_OBJS) stage0_kernel_blob.o $(N64_BOARD_SRC)/stage0_linker.ld
	$(LD) --defsym=N64_STAGE0_RESERVED_BYTES=$(N64_STAGE0_RESERVED_BYTES) \
	    -T $(N64_BOARD_SRC)/stage0_linker.ld -nostdlib -o $@ \
	    $(N64_STAGE0_OBJS) stage0_kernel_blob.o

kernel_stage0.elf: $(N64_STAGE0_OBJS) kernel_stage0_kernel_blob.o $(N64_BOARD_SRC)/stage0_linker.ld
	$(LD) --defsym=N64_STAGE0_RESERVED_BYTES=$(N64_STAGE0_RESERVED_BYTES) \
	    -T $(N64_BOARD_SRC)/stage0_linker.ld -nostdlib -o $@ \
	    $(N64_STAGE0_OBJS) kernel_stage0_kernel_blob.o

stage0.stripped.elf: stage0.elf
	$(STRIP) -s -o $@ $<

kernel_stage0.stripped.elf: kernel_stage0.elf
	$(STRIP) -s -o $@ $<

$(N64_BUILD_MODE_STAMP):
	rm -f .build-mode.*
	touch $@

ifeq ($(N64_MINIMAL_ROOTFS),1)
$(N64_PCC_HOST_INCLUDE_STAMP): $(MIPS_INCLUDE_SRCS) \
    $(MIPS_INCLUDE_LINKS) $(MIPS_INSTALL_USER_HEADERS)
	$(MIPS_INSTALL_USER_HEADERS) $(TOPSRC) \
	    $(N64_PCC_HOST_INCLUDE) \
	    "$(MIPS_BOARD_MACHINE_HEADER_DIR)" \
	    no \
	    "$(MIPS_SHARED_MACHINE_HEADERS)" \
	    $(MIPS_COMMON_MACHINE_HEADERS)
	touch $@
endif

$(N64_ROOTFS_DEVNODES): $(N64_DEVNODES_SRCS) Makefile
	awk -v cons_major="$(N64_CONS_MAJOR)" -v cons_minor="$(N64_CONS_MINOR)" -v pty_enabled="$(N64_PTY_ENABLED)" -v pty_nunits="$(N64_PTY_NUNITS)" -f $(N64_DEVNODES_AWK) $(TOPSRC)/sys/mips/n64/romdisk.h $(TOPSRC)/sys/mips/n64/ramswap.h $(TOPSRC)/sys/mips/n64/devmajors.h $(TOPSRC)/sys/include/conf.h $(TOPSRC)/sys/include/pty.h > $@

$(N64_MINIMAL_ROOTFS_STAGE)/.stamp: $(MIPS_ROOTFS_USER_LDSCRIPT) \
    $(N64_MINIMAL_ROOTFS_FILES) $(N64_TERMCAP) \
    $(N64_UTILITY_SMOKE_SRCS) $(N64_LINPACK_SMOKE_SRC) \
    $(MIPS_COMPILER_BENCH_SRC) $(MIPS_NATIVE_CRT0_SRC) \
    $(MIPS_LIBC_SRCS) $(MIPS_LIBM_SRCS) $(MIPS_LIBUTIL_SRCS) \
    $(N64_LIBREADLINE_SRCS) \
    $(MIPS_USER_SRCS) \
    $(N64_MINIMAL_USERLAND_EXTRA_DEPS) $(N64_PCC_HOST_INCLUDE_STAMP) \
    $(TOPSRC)/src/Makefile $(TOPSRC)/src/cmd/Makefile Makefile
	rm -rf $(MIPS_BUILD_ROOT)
	mkdir -p $(MIPS_BUILD_SRC_DIR)
	cp -pR $(TOPSRC)/src/. $(MIPS_BUILD_SRC_DIR)/
	ln -s $(abspath $(TOPSRC))/.git $(MIPS_BUILD_ROOT)/.git
	ln -s $(abspath $(TOPSRC))/include $(MIPS_BUILD_ROOT)/include
	ln -s $(abspath $(TOPSRC))/lib $(MIPS_BUILD_ROOT)/lib
	ln -s $(abspath $(TOPSRC))/sys $(MIPS_BUILD_ROOT)/sys
	ln -s $(abspath $(TOPSRC))/tools $(MIPS_BUILD_ROOT)/tools
	ln -s $(abspath $(TOPSRC))/target.mk $(MIPS_BUILD_ROOT)/target.mk
	ln -s $(abspath $(TOPSRC))/target-mips.mk $(MIPS_BUILD_ROOT)/target-mips.mk
	ln -s $(abspath $(TOPSRC))/target-n64.mk $(MIPS_BUILD_ROOT)/target-n64.mk
	$(N64_MINIMAL_SRC_MAKE) clean
	rm -rf $(N64_MINIMAL_ROOTFS_STAGE)
	mkdir -p $(N64_MINIMAL_ROOTFS_STAGE)/bin \
	    $(N64_MINIMAL_ROOTFS_STAGE)/dev \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc \
	    $(N64_MINIMAL_ROOTFS_STAGE)/lib \
	    $(N64_MINIMAL_ROOTFS_STAGE)/libexec \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root \
	    $(N64_MINIMAL_ROOTFS_STAGE)/sbin \
	    $(N64_MINIMAL_ROOTFS_STAGE)/share/man/cat1 \
	    $(N64_MINIMAL_ROOTFS_STAGE)/share/man/cat5 \
	    $(N64_MINIMAL_ROOTFS_STAGE)/share/man/cat8 \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/bin \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/include \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/lib/ldscripts \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/libexec/pcc \
	    $(N64_MINIMAL_ROOTFS_STAGE)/var/db \
	    $(N64_MINIMAL_ROOTFS_STAGE)/var/lock \
	    $(N64_MINIMAL_ROOTFS_STAGE)/var/log \
	    $(N64_MINIMAL_ROOTFS_STAGE)/var/run \
	    $(N64_MINIMAL_ROOTFS_STAGE)/var/tmp
	cp -p $(TOPSRC)/sys/mips/rootfs/etc/group \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc/group
	cp -p $(TOPSRC)/sys/mips/rootfs/etc/passwd \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc/passwd
	cp -p $(TOPSRC)/sys/mips/rootfs/etc/profile \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc/profile
ifeq ($(N64_MINIMAL_USBNET_DEBUG),1)
	cp -p $(TOPSRC)/sys/mips/rootfs/etc/hosts \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc/hosts
	cp -p $(TOPSRC)/sys/mips/rootfs/etc/services \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc/services
	ln -s ../var/run/resolv.conf \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc/resolv.conf
endif
	cp -p $(TOPSRC)/sys/mips/n64/rootfs/etc/gettytab \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc/gettytab
	cp -p $(TOPSRC)/sys/mips/n64/rootfs/etc/motd \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc/motd
ifeq ($(N64_DEBUG_UART_ONLY),1)
	{ \
	    printf '%s\n' '# name    getty                           type    status      comments'; \
	    printf '%s\n' 'console   "/libexec/getty std.default"    vt100   on secure'; \
	} > $(N64_MINIMAL_ROOTFS_STAGE)/etc/ttys
else
	cp -p $(TOPSRC)/sys/mips/n64/rootfs/etc/ttys \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc/ttys
endif
	cp -p $(N64_TERMCAP) $(N64_MINIMAL_ROOTFS_STAGE)/etc/termcap
	cp -p $(TOPSRC)/sys/mips/rootfs/root/.profile \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/.profile
	ln -s var/tmp $(N64_MINIMAL_ROOTFS_STAGE)/tmp
	{ \
	    printf '%s\n' '#!/bin/sh'; \
	    printf '%s\n' 'PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH'; \
	    printf '%s\n' 'echo N64_MINIMAL_RC_BEGIN'; \
	    printf '%s\n' 'if mkfs -i 4096 /dev/ram0 >/dev/null; then'; \
	    printf '%s\n' '	if mount /var >/dev/null; then'; \
	    printf '%s\n' '		mkdir /var/db /var/log /var/run /var/tmp /var/lock 2>/dev/null'; \
	    printf '%s\n' '		chmod 1777 /var/tmp'; \
	    printf '%s\n' '		: >/var/run/utmp'; \
	    printf '%s\n' '		: >/var/log/wtmp'; \
	    printf '%s\n' '		chmod 664 /var/run/utmp /var/log/wtmp'; \
	    printf '%s\n' '	else'; \
	    printf '%s\n' '		echo N64_MINIMAL_VAR_MOUNT_FAIL'; \
	    printf '%s\n' '		exit 1'; \
	    printf '%s\n' '	fi'; \
	    printf '%s\n' 'else'; \
	    printf '%s\n' '	echo N64_MINIMAL_VAR_MKFS_FAIL'; \
	    printf '%s\n' '	exit 1'; \
	    printf '%s\n' 'fi'; \
	    printf '%s\n' 'echo N64_MINIMAL_RC_END'; \
	    printf '%s\n' 'exit 0'; \
	} > $(N64_MINIMAL_ROOTFS_STAGE)/etc/rc
	chmod 0775 $(N64_MINIMAL_ROOTFS_STAGE)/etc/rc
	{ \
	    printf '%s\n' '/dev/romdisk	/	ufs	ro	0	0'; \
	    printf '%s\n' '/dev/ram0	/var	ufs	rw	0	0'; \
	    printf '%s\n' '/dev/swap	none	swap	sw	0	0'; \
	} > $(N64_MINIMAL_ROOTFS_STAGE)/etc/fstab
	# Keep build and installation as separate make invocations.  With a
	# parallel parent make, passing both goals at once lets install race all;
	# the legacy recursive install rules ignore missing-file errors, which can
	# otherwise produce a valid-looking ROM with no /sbin/init.
	$(N64_MINIMAL_SRC_MAKE) all
	$(N64_MINIMAL_SRC_MAKE) install
	for bin in $(N64_MINIMAL_ROOTFS_USR_BIN_FILES); do \
	    test -x $(N64_MINIMAL_ROOTFS_STAGE)/bin/$$bin; \
	    mv -f $(N64_MINIMAL_ROOTFS_STAGE)/bin/$$bin \
	        $(N64_MINIMAL_ROOTFS_STAGE)/usr/bin/$$bin; \
	done
	test -x $(N64_MINIMAL_ROOTFS_STAGE)/sbin/init
	test -x $(N64_MINIMAL_ROOTFS_STAGE)/bin/sh
	test -x $(N64_MINIMAL_ROOTFS_STAGE)/libexec/getty
	test -x $(N64_MINIMAL_ROOTFS_STAGE)/sbin/mkfs
	test -x $(N64_MINIMAL_ROOTFS_STAGE)/sbin/mount
	test -x $(N64_MINIMAL_ROOTFS_STAGE)/usr/bin/vm-pressure-smoke
	cp -p $(N64_MINIMAL_VM_STRESS_SCRIPT) \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/vm-stress-smoke.sh
	$(N64_MINIMAL_USERLAND_CC) -O2 -c \
	    -o $(N64_MINIMAL_VM_PROCESS_OBJ) $(N64_MINIMAL_VM_PROCESS_SRC)
	$(N64_MINIMAL_USERLAND_AS) \
	    -o $(N64_MINIMAL_VM_PROCESS_GPR64_OBJ) \
	    $(N64_MINIMAL_VM_PROCESS_GPR64_SRC)
	$(N64_MINIMAL_USERLAND_LD) $(N64_MINIMAL_USERLAND_LDFLAGS) \
	    -o $(N64_MINIMAL_VM_PROCESS_LINKED) \
	    $(N64_MINIMAL_VM_PROCESS_OBJ) \
	    $(N64_MINIMAL_VM_PROCESS_GPR64_OBJ) -lc
	$(N64_MINIMAL_USERLAND_ELF2AOUT) $(N64_MINIMAL_VM_PROCESS_LINKED) \
	    $(N64_MINIMAL_VM_PROCESS_BIN)
	cp -p $(N64_MINIMAL_VM_PROCESS_BIN) \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/vm-process-smoke
	chmod 0775 $(N64_MINIMAL_ROOTFS_STAGE)/root/vm-process-smoke \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/vm-stress-smoke.sh
ifeq ($(N64_MINIMAL_USBNET_DEBUG),1)
	cp -p $(N64_MINIMAL_USBNET_TEST_FILES) \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/
	chmod 0775 $(addprefix $(N64_MINIMAL_ROOTFS_STAGE)/root/,\
	    $(N64_MINIMAL_USBNET_TEST_NAMES))
endif
ifeq ($(N64_MINIMAL_PCC_SMOKE),1)
	cp -p $(N64_MINIMAL_ROOTFS_PCC_TEST_FILES) \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/
	printf '%s\n' 'PCC_SMOKE_TRACE=0' > \
	    $(N64_MINIMAL_ROOTFS_STAGE)/etc/pcc-smoke.conf
	mkdir -p $(N64_MINIMAL_ROOTFS_STAGE)/root/utility-src
	cp -p $(N64_UTILITY_SMOKE_SRCS) \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/utility-src/
	cp -pR $(N64_PCC_HOST_INCLUDE)/. \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/include/
	cp -p $(MIPS_NATIVE_PCC_DIR)/cc \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/bin/cc
	cp -p $(MIPS_NATIVE_PCC_DIR)/cc \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/bin/pcc
	cp -p $(MIPS_NATIVE_PCC_DIR)/cc \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/bin/cpp
	cp -p $(MIPS_NATIVE_PCC_DIR)/cpp \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/libexec/pcc/cpp
	cp -p $(MIPS_NATIVE_PCC_DIR)/ccom \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/libexec/pcc/ccom
	for lib in $(MIPS_NATIVE_LIBS); do \
	    cp -p $(MIPS_NATIVE_DIR)/$$lib \
	        $(N64_MINIMAL_ROOTFS_STAGE)/usr/lib/$$lib; \
	done
	cp -p $(MIPS_ROOTFS_USER_LDSCRIPT) \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/lib/$(MIPS_ROOTFS_INSTALLED_LDSCRIPT)
	for lib in libc.a libm.a libpcc.a; do \
	    $(MIPS_PCC_RANLIB) $(N64_MINIMAL_ROOTFS_STAGE)/usr/lib/$$lib; \
	done
	for bin in aout ar as cmp ld make nm ranlib size; do \
	    if [ -e $(N64_MINIMAL_ROOTFS_STAGE)/bin/$$bin ]; then \
	        mv -f $(N64_MINIMAL_ROOTFS_STAGE)/bin/$$bin \
	            $(N64_MINIMAL_ROOTFS_STAGE)/usr/bin/$$bin; \
	    fi; \
	done
	ln -s ../usr/bin/cpp $(N64_MINIMAL_ROOTFS_STAGE)/bin/cpp
	ln -s usr/include $(N64_MINIMAL_ROOTFS_STAGE)/include
	ln -s ../usr/lib/crt0.o $(N64_MINIMAL_ROOTFS_STAGE)/lib/crt0.o
	ln -s ../usr/lib/libc.a $(N64_MINIMAL_ROOTFS_STAGE)/lib/libc.a
	ln -s ../usr/lib/libm.a $(N64_MINIMAL_ROOTFS_STAGE)/lib/libm.a
	ln -s ../usr/lib/libpcc.a $(N64_MINIMAL_ROOTFS_STAGE)/lib/libpcc.a
	$(N64_MINIMAL_USERLAND_CC) -O2 -c \
	    -o $(N64_MINIMAL_LIBC_ABI_OBJ) \
	    $(TOPSRC)/sys/mips/rootfs/root/libc-abi-smoke.c
	$(N64_MINIMAL_USERLAND_LD) $(N64_MINIMAL_USERLAND_LDFLAGS) \
	    -o $(N64_MINIMAL_LIBC_ABI_LINKED) \
	    $(N64_MINIMAL_LIBC_ABI_OBJ) -lc
	$(N64_MINIMAL_USERLAND_ELF2AOUT) $(N64_MINIMAL_LIBC_ABI_LINKED) \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/libc-abi-smoke
	$(N64_MINIMAL_USERLAND_CC) -O2 -c \
	    -o $(N64_MINIMAL_LINPACK_OBJ) $(N64_LINPACK_SMOKE_SRC)
	$(N64_MINIMAL_USERLAND_LD) $(N64_MINIMAL_USERLAND_LDFLAGS) \
	    -o $(N64_MINIMAL_LINPACK_LINKED) \
	    $(N64_MINIMAL_LINPACK_OBJ) -lm -lc
	$(N64_MINIMAL_USERLAND_ELF2AOUT) $(N64_MINIMAL_LINPACK_LINKED) \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/linpack-pcc
	$(N64_MINIMAL_USERLAND_CC) -O2 -c \
	    -o $(N64_MINIMAL_COMPILER_BENCH_OBJ) \
	    $(MIPS_COMPILER_BENCH_SRC)
	$(N64_MINIMAL_USERLAND_LD) $(N64_MINIMAL_USERLAND_LDFLAGS) \
	    -o $(N64_MINIMAL_COMPILER_BENCH_LINKED) \
	    $(N64_MINIMAL_COMPILER_BENCH_OBJ) -lc
	$(N64_MINIMAL_USERLAND_ELF2AOUT) \
	    $(N64_MINIMAL_COMPILER_BENCH_LINKED) \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/mips-compiler-bench-pcc
	chmod 0775 $(N64_MINIMAL_ROOTFS_STAGE)/root/*.sh \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/libc-abi-smoke \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/linpack-pcc \
	    $(N64_MINIMAL_ROOTFS_STAGE)/root/mips-compiler-bench-pcc \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/bin/* \
	    $(N64_MINIMAL_ROOTFS_STAGE)/usr/libexec/pcc/*
endif
	rm -rf $(N64_MINIMAL_ROOTFS_STAGE)/share
	touch $@

$(N64_MINIMAL_ROOTFS_MANIFEST): $(N64_MINIMAL_ROOTFS_STAGE)/.stamp \
    $(N64_ROOTFS_DEVNODES) $(MIPS_ROOTFS_MANIFEST_SCRIPT)
	python3 $(MIPS_ROOTFS_MANIFEST_SCRIPT) \
	    --stage $(N64_MINIMAL_ROOTFS_STAGE) \
	    --output $@ \
	    --devices $(N64_ROOTFS_DEVNODES)

$(N64_MINIMAL_ROOTFS_IMG): $(FSUTIL) $(MIPS_ROOTFS_CHECK_SCRIPT) \
    $(N64_MINIMAL_ROOTFS_MANIFEST)
	python3 $(MIPS_ROOTFS_CHECK_SCRIPT) \
	    --stage $(N64_MINIMAL_ROOTFS_STAGE) \
	    --manifest $(N64_MINIMAL_ROOTFS_MANIFEST) \
	    $(MIPS_ROOTFS_CHECK_PROFILE_ARGS) \
	    --label n64-minimal
	rm -f $@
	$(FSUTIL) --new --endian=$(N64_USERLAND_ENDIAN) \
	    --size=$(N64_MINIMAL_ROOTFS_KBYTES) \
	    --manifest=$(N64_MINIMAL_ROOTFS_MANIFEST) \
	    $@ $(N64_MINIMAL_ROOTFS_STAGE)
	$(FSUTIL) --check $@

.PHONY: pcc-debug-stage pcc-debug-image pcc-hw-test-stage pcc-hw-test-image
$(N64_PCC_DEBUG_RUNNER_OBJ): $(N64_PCC_DEBUG_RUNNER_SRC) \
    $(N64_NATIVE_STAMP) $(N64_NATIVE_AS)
	N64_AOUT_TOPSRC=$(abspath $(TOPSRC)) \
	    N64_AOUT_AS=$(abspath $(N64_NATIVE_AS)) \
	    N64_PREFIX=$(N64_PREFIX) \
	    $(N64_NATIVE_CC) -O -fno-builtin -fno-stack-protector \
	    $(filter -DN64_DEBUG_USERMEM_4M,$(PARAM)) \
	    -c -o $@ $<

$(N64_PCC_DEBUG_RUNNER): $(N64_PCC_DEBUG_RUNNER_OBJ) \
    $(N64_NATIVE_LD) $(N64_NATIVE_DIR)/crt0.o \
    $(N64_NATIVE_DIR)/libc.a $(N64_NATIVE_DIR)/libpcc.a
	$(N64_NATIVE_LD) -X -d -e _start -o $@ \
	    $(N64_NATIVE_DIR)/crt0.o $(N64_PCC_DEBUG_RUNNER_OBJ) \
	    $(if $(filter soft,$(N64_USERLAND_FLOAT)),-L $(N64_NATIVE_SOFTFLOAT_DIR),) \
	    -L $(N64_NATIVE_DIR) -lc -lpcc

pcc-debug-stage: $(N64_ROOTFS_USER_STAMP) $(N64_LINPACK_ROOTFS_STAMP) \
    $(N64_COMPILER_BENCH_ROOTFS_STAMP) \
    $(N64_PCC_DEBUG_ROOTFS_SCRIPT) \
    $(N64_PCC_DEBUG_RUNNER) $(N64_PCC_TEST_SRCS)
	python3 $(N64_PCC_DEBUG_ROOTFS_SCRIPT) \
	    --top $(abspath $(TOPSRC)) \
	    --src-rootfs $(abspath $(N64_ROOTFS_STAGE)) \
	    --out-rootfs $(abspath $(N64_PCC_DEBUG_ROOTFS_STAGE)) \
	    --manifest-out $(abspath $(N64_PCC_DEBUG_ROOTFS_MANIFEST)) \
	    --runner $(abspath $(N64_PCC_DEBUG_RUNNER))

$(N64_PCC_DEBUG_ROOTFS_IMG): $(FSUTIL) pcc-debug-stage
	rm -f $@
	$(FSUTIL) --new --endian=$(N64_USERLAND_ENDIAN) \
	    --size=$(N64_PCC_DEBUG_ROOTFS_KBYTES) \
	    --manifest=$(N64_PCC_DEBUG_ROOTFS_MANIFEST) \
	    $@ $(N64_PCC_DEBUG_ROOTFS_STAGE)
	$(FSUTIL) --check $@

pcc-debug.z64: kernel_stage0.stripped.elf $(N64_PCC_DEBUG_ROOTFS_IMG)
	cp $(N64_PCC_DEBUG_ROOTFS_IMG) $(N64_PCC_DEBUG_TOC_ROOTFS_IMG)
	$(N64_TOOL) --toc --title "REBSD PCCDBG" --output $@ --align 256 kernel_stage0.stripped.elf --align 1024 $(N64_PCC_DEBUG_TOC_ROOTFS_IMG)

pcc-debug-image:
	$(MAKE) clean
	$(MAKE) N64_DEBUG_UART_ONLY=1 N64_USERLAND_COMPILER=pcc \
	    N64_PCC_DEBUG_ROOTFS_KBYTES=$(N64_PCC_DEBUG_ROOTFS_KBYTES) \
	    pcc-debug.z64

pcc-hw-test-stage: $(N64_ROOTFS_BUILD_MANIFEST) $(MIPS_PCC_PROVIDER_DEPS) \
    $(N64_NATIVE_AS) $(N64_NATIVE_LD) $(N64_NATIVE_AOUT_AR) \
    $(N64_LINPACK_SMOKE_SCRIPT) $(N64_LINPACK_SMOKE_SRC) \
    $(N64_PCC_REGRESS_SCRIPT) $(N64_PCC_TEST_SRCS)
	python3 $(N64_LINPACK_SMOKE_SCRIPT) build \
	    --source $(abspath $(N64_LINPACK_SMOKE_SRC)) \
	    --out $(N64_LINPACK_SMOKE_OUT) \
	    --rootfs $(abspath $(N64_ROOTFS_STAGE)) \
	    --pcc $(MIPS_PCC_CC) \
	    --cpu $(N64_USERLAND_CPU) \
	    --float-abi $(N64_USERLAND_FLOAT) \
	    --endian $(N64_USERLAND_ENDIAN)
	python3 $(N64_LINPACK_SMOKE_SCRIPT) stage \
	    --out $(N64_LINPACK_SMOKE_OUT) \
	    --rootfs $(abspath $(N64_ROOTFS_STAGE)) \
	    --manifest $(abspath $(N64_ROOTFS_BUILD_MANIFEST)) \
	    --manifest-out $(abspath $(N64_LINPACK_SMOKE_MANIFEST))
	python3 $(N64_PCC_REGRESS_SCRIPT) native-stage \
	    --rootfs $(abspath $(N64_ROOTFS_STAGE)) \
	    --manifest $(abspath $(N64_LINPACK_SMOKE_MANIFEST)) \
	    --manifest-out $(abspath $(N64_PCC_HW_REGRESS_MANIFEST))

pcc-hw-test-image: pcc-hw-test-stage
	rm -f rootfs.img kernel.z64 preflight.z64
	$(MAKE) N64_ROOTFS_BUILD_MANIFEST=$(N64_PCC_HW_REGRESS_MANIFEST) \
	    rootfs.img kernel.z64 preflight.z64

$(FSUTIL):
	$(MAKE) -C $(TOPSRC)/tools/fsutil

preflight.z64: stage0.stripped.elf $(N64_ROM_ROOTFS_IMG)
	$(N64_TOOL) --toc --title "REBSD N64" --output $@ --align 256 stage0.stripped.elf --align 1024 $(N64_ROM_ROOTFS_IMG)

kernel.z64: kernel_stage0.stripped.elf $(N64_ROM_ROOTFS_IMG)
	$(N64_TOOL) --toc --title "REBSD N64" --output $@ --align 256 kernel_stage0.stripped.elf --align 1024 $(N64_ROM_ROOTFS_IMG)

preflight.o: $(N64_BOARD_SRC)/preflight.c ${SYSTEM_DEP}
	${COMPILE_C}

preflight_n64cart_uart.o: $(N64_BOARD_SRC)/preflight_n64cart_uart.c $(N64_BOARD_SRC)/n64cart_uart.h ${SYSTEM_DEP}
	${COMPILE_C}

startup.o: $S/mips/common/startup.S ${SYSTEM_DEP}
	${COMPILE_S}

preflight_startup.o: $S/mips/common/startup.S ${SYSTEM_DEP}
	${CC} ${CFLAGS} ${CPPFLAGS} -DN64_PREFLIGHT ${DEPFLAGS} -c $< -o $@

ioconf.o: ioconf.c ${SYSTEM_DEP}
	${COMPILE_C}

ioconf.debug-uart.o: $(N64_BOARD_SRC)/ioconf.debug-uart.c ${SYSTEM_DEP}
	${COMPILE_C}

n64gdb.o: $(N64_BOARD_SRC)/n64gdb.c $(N64_BOARD_SRC)/n64gdb.h ${SYSTEM_DEP}
	${COMPILE_C}

n64cart_usbgdb.o: $(N64_BOARD_SRC)/n64cart_usbgdb.c \
    $(N64_BOARD_SRC)/n64cart_usbnet.c $(N64_BOARD_SRC)/n64gdb.h ${SYSTEM_DEP}
	${COMPILE_C}

n64reset.o: $(N64_BOARD_SRC)/n64reset.c $(N64_BOARD_SRC)/n64reset.h ${SYSTEM_DEP}
	${COMPILE_C}

${SYSTEM_OBJ} swapunix.o preflight.o: | machine sys .deps
${SYSTEM_OBJ} swapunix.o preflight.o $(N64_STAGE0_OBJS) \
    $(N64_PREFLIGHT_OBJS): $(N64_BUILD_MODE_STAMP)

clean: mips-rootfs-clean
	rm -rf *.o *.elf *.bin *.img *.dis *.nm *.z64 *.d a.out n64-init \
	    .deps machine sys $(N64_PCC_DEBUG_ROOTFS_STAGE) \
	    $(N64_MINIMAL_ROOTFS_STAGE) $(N64_MINIMAL_ROOTFS_MANIFEST) \
	    $(N64_MINIMAL_VM_PROCESS_GPR64_OBJ) \
	    $(N64_MINIMAL_VM_PROCESS_LINKED) $(N64_MINIMAL_VM_PROCESS_BIN) \
	    $(N64_PCC_HOST_INCLUDE) \
	    $(N64_KERNEL_LDSCRIPT) .build-mode.* $(N64_PCC_DEBUG_RUNNER) \
	    n64-native-runtime-seed.*

clean-all: clean
	rm -f Makefile ioconf.c swap*.c vers.c

reconfig ioconf.c swapunix.c: $(N64_BOARD_SRC)/Config $(OBJTOP)/tools/kconfig/kconfig | machine sys
	$(OBJTOP)/tools/kconfig/kconfig $<

.PHONY: machine sys
machine:
	ln -sfn $(N64_BOARD_SRC) $@

sys:
	ln -sfn $(TOPSRC)/sys/include $@

.deps:
	mkdir .deps

%RULES

-include .deps/*.dep
