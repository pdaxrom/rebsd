               LIBC_COMPILER_RUNTIME=$(if $(filter pcc,$(MIPS_ROOTFS_COMPILER)),libpcc,libc) \
               SRC_ONLY_LIBS="startup-mips libc libm libutil libreadline" \
               SRC_ONLY_SUBDIR="cmd" \
