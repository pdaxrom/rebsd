	RANLIB="$(abspath $(MIPS_NATIVE_AOUT_RANLIB))" \
	LIBC_COMPILER_RUNTIME=libc
N64_LINPACK_GCC_LIBM_MAKE = $(MAKE) -C $(N64_LINPACK_GCC_RUNTIME_TREE)/src/libm \
	TARGET_PLATFORM=n64 MIPS_ROOTFS_CPU=$(N64_USERLAND_CPU) \
	MIPS_ROOTFS_ENDIAN=$(N64_USERLAND_ENDIAN) \
	N64_USER_LDSCRIPT=$(abspath $(N64_USER_LDSCRIPT)) \
	CC="$(N64_LINPACK_GCC_RUNTIME_CC)" \
