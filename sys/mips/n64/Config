#
# Nintendo 64 under the shared MIPS architecture tree.
#
architecture    "mips"
cpu             "VR4300"
board           "N64"

options         "CONS_MAJOR=0", "CONS_MINOR=0"
options         "VIDEO_ENABLED", "INPUT_ENABLED"
options         "MIPS_ZSWAP_ENABLED"

#
# Cartridge-specific hardware used by this board configuration.
#
device          "n64cart"       # n64cart cartridge UART/register block

# Pseudo terminals
service         nintendo
service         pty     4
service         ether   1
service         usbnet
options         "USBNET_ECM"
service         inet
service         unixdomain

config          unix    root on major 0 minor 0
                        swap on major 1 minor 0
