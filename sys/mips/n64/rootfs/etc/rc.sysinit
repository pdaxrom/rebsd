#!/bin/sh
HOME=/; export HOME
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH

/bin/hostname n64

# The cartridge root remains read-only. Size the runtime devices from installed
# RAM; ram0 and ram1 are otherwise identical dynamic devices.
physmem=`/bin/sysctl -n hw.physmem`
if test "$physmem" -le 4194304; then
	var_size=128K
	swap_backing=384K
else
	var_size=1M
	swap_backing=2M
fi
/usr/sbin/ramctl create /dev/ram0 size=$var_size >/dev/null
if mkfs -i 4096 /dev/ram0 >/dev/null; then
	if mount /var; then
		mkdir /var/config /var/db /var/log /var/run /var/tmp /var/lock 2>/dev/null
		chmod 1777 /var/tmp
		: >/var/run/utmp
		: >/var/log/wtmp
		chmod 664 /var/run/utmp /var/log/wtmp
	fi
fi

# Compression belongs to the RAM block device; swap itself remains the
# standard Linux swap v1 format and is attached by userland.
if /usr/sbin/ramctl create /dev/ram1 backing=$swap_backing size=2x compression; then
	if /usr/sbin/mkswap /dev/ram1; then
		/usr/sbin/swapon /dev/ram1
	fi
fi

# The n64cart cartridge flash is fixed hardware, not removable media.
# init deliberately runs rc with normal output detached. Keep a cartridge
# mount failure fatal, but send mount_romfs's errno to the visible console.
mount /cart >/dev/console 2>&1
