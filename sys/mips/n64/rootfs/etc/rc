#!/bin/sh
HOME=/; export HOME
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH

/bin/hostname n64

# The cartridge root remains read-only. Create one volatile UFS filesystem for
# runtime state; /tmp is a rootfs symlink to /var/tmp.
if mkfs -i 4096 /dev/ram0 >/dev/null; then
	if mount /var; then
		mkdir /var/db /var/log /var/run /var/tmp /var/lock 2>/dev/null
		chmod 1777 /var/tmp
		: >/var/run/utmp
		: >/var/log/wtmp
		chmod 664 /var/run/utmp /var/log/wtmp
	fi
fi

# The n64cart cartridge flash is fixed hardware, not removable media.
mount /cart
