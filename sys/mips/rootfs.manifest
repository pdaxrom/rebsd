#
# Shared MIPS root filesystem layout for the N64 and Malta ports.
#
default
owner 0
group 0
dirmode 0775
filemode 0664

dir /bin
dir /cart
dir /dev
dir /etc
dir /lib
dir /libexec
dir /root
dir /sbin
dir /usr
