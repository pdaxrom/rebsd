#
# Makefile template for shared MIPS ports.
#
MALTA_MEMORY_PROFILE ?= default
MALTA_MEMORY_PROFILES = default n64-8m
ifeq ($(filter $(MALTA_MEMORY_PROFILE),$(MALTA_MEMORY_PROFILES)),)
$(error Unsupported MALTA_MEMORY_PROFILE=$(MALTA_MEMORY_PROFILE); expected one of $(MALTA_MEMORY_PROFILES))
endif
MALTA_N64_8M_PROFILE = $(filter n64-8m,$(MALTA_MEMORY_PROFILE))
MALTA_PORT64 = $(filter -DMALTA64,$(PARAM))
CI20_PORT = $(filter -DCI20,$(PARAM))
ifneq ($(MALTA_N64_8M_PROFILE),)
ifeq ($(MALTA_PORT64),)
$(error MALTA_MEMORY_PROFILE=n64-8m requires BOARD=malta64)
endif
endif
MALTA_CPU_TUNE ?= $(if $(MALTA_PORT64),r4000,24kf)
MIPS_ARCH_ENDIAN ?= $(if $(filter little,$(MIPS_ROOTFS_ENDIAN)),-EL,-EB)
MIPS_ARCH ?= $(if $(MALTA_PORT64),$(MIPS_ARCH_ENDIAN) -mips3 -mabi=32 -mtune=$(MALTA_CPU_TUNE),$(MIPS_ARCH_ENDIAN) -mips32 -mabi=32 -mtune=$(MALTA_CPU_TUNE))
MALTA_QEMU_RAM ?= $(if $(filter 1,$(MIPS_ROOTFS_NATIVE_PCC)),64M,$(if $(filter pcc,$(USERLAND_COMPILER)),64M,32M))
MALTA_RAM_KBYTES ?= $(if $(MALTA_N64_8M_PROFILE),8192,$(if $(filter 1,$(MIPS_ROOTFS_NATIVE_PCC)),65536,$(if $(filter pcc,$(USERLAND_COMPILER)),65536,32768)))
ifneq ($(MALTA_N64_8M_PROFILE),)
ifneq ($(MALTA_RAM_KBYTES),8192)
$(error MALTA_MEMORY_PROFILE=n64-8m requires MALTA_RAM_KBYTES=8192)
endif
endif
CI20_RAM_KBYTES ?= 1048576
MALTA_QEMU ?= $(if $(MALTA_PORT64),qemu-system-mips64,qemu-system-mips)
MALTA_QEMU_CPU ?= $(if $(MALTA_PORT64),R4000,)
MALTA_QEMU_CPU_OPT = $(if $(MALTA_QEMU_CPU),-cpu $(MALTA_QEMU_CPU),)
MALTA_QEMU_CPU_ARG = $(if $(MALTA_QEMU_CPU),--cpu $(MALTA_QEMU_CPU),)
MALTA_VR4300_QEMU ?= qemu-system-mips64
MALTA_VR4300_CPU ?= R4000

include ../../../target-mips.mk

TOPSRC          = ../../..
S               = $(TOPSRC)/sys
BOARD_SRC       ?= $(TOPSRC)/sys/mips/malta
MALTA_HW_MODEL ?= $(if $(MALTA_N64_8M_PROFILE),MIPS Malta R4000 N64 8MiB profile,$(if $(MALTA_PORT64),MIPS Malta R4000,MIPS Malta 24Kf))
MALTA_VERSION_NAME ?= $(if $(MALTA_PORT64),Malta64,Malta)
MALTA_KERNEL_LD_SCRIPT ?= $(if $(MALTA_N64_8M_PROFILE),$(TOPSRC)/sys/mips/malta/malta-n64-8m.ld,$(TOPSRC)/sys/mips/malta/malta.ld)
MALTA64_SRC ?= $(TOPSRC)/sys/mips/malta64
MALTA64_STAGE_LD_SCRIPT ?= $(if $(MALTA_N64_8M_PROFILE),$(MALTA64_SRC)/stage0_n64_8m_linker.ld,$(MALTA64_SRC)/stage0_linker.ld)
MALTA_RUNTIME_KERNEL ?= $(if $(MALTA_PORT64),malta64.elf,unix.elf)
MALTA_EARLY_TARGET ?= $(if $(CI20_PORT),,$(if $(MALTA_PORT64),malta64-early.elf,malta-early.elf))
MALTA64_STAGE_ARCH ?= -EB -mips3 -mabi=64 -mtune=r4000
MALTA64_STAGE_CC = $(MIPS_PREFIX)gcc $(MALTA64_STAGE_ARCH) $(MIPS_CODE)
MALTA64_STAGE_ASFLAGS = -x assembler-with-cpp -c -I. -I$(TOPSRC)/include \
                        $(PARAM) -DKERNEL -DMIPS \
                        $(if $(MALTA_N64_8M_PROFILE),-DMALTA_N64_8M_PROFILE,) \
                        -Wa,-I.
MALTA64_STAGE_LD ?= ld.lld
MALTA64_STAGE_LDFLAGS ?= -m elf64btsmip -nostdlib
MALTA64_LLVM_BINDIR ?= /opt/homebrew/opt/llvm/bin
MALTA64_STAGE_SIZE ?= $(MALTA64_LLVM_BINDIR)/llvm-size
MALTA64_STAGE_OBJDUMP ?= $(MALTA64_LLVM_BINDIR)/llvm-objdump
USERLAND_COMPILER ?= gcc
USERLAND_COMPILERS = gcc pcc
ifeq ($(filter $(USERLAND_COMPILER),$(USERLAND_COMPILERS)),)
$(error Unsupported USERLAND_COMPILER=$(USERLAND_COMPILER); expected one of $(USERLAND_COMPILERS))
endif
MIPS_ROOTFS_PROFILE ?= full
MIPS_ROOTFS_NATIVE_PCC ?= $(if $(filter minimal,$(MIPS_ROOTFS_PROFILE)),0,1)
MIPS_ROOTFS_KBYTES ?= $(if $(filter minimal,$(MIPS_ROOTFS_PROFILE)),6144,$(if $(filter 1,$(MIPS_ROOTFS_NATIVE_PCC)),32768,$(if $(filter pcc,$(USERLAND_COMPILER)),32768,16384)))
MIPS_ROOTFS_CPU ?= $(if $(N64_USERLAND_CPU),$(N64_USERLAND_CPU),$(if $(MALTA_PORT64),vr4300,mips32r2))
MIPS_ROOTFS_CPUS = vr4300 mips32r2
ifneq ($(N64_USERLAND_CPU),)
ifneq ($(MIPS_ROOTFS_CPU),$(N64_USERLAND_CPU))
$(error MIPS_ROOTFS_CPU=$(MIPS_ROOTFS_CPU) conflicts with N64_USERLAND_CPU=$(N64_USERLAND_CPU))
endif
endif
ifeq ($(filter $(MIPS_ROOTFS_CPU),$(MIPS_ROOTFS_CPUS)),)
$(error Unsupported MIPS_ROOTFS_CPU=$(MIPS_ROOTFS_CPU); expected one of $(MIPS_ROOTFS_CPUS))
endif
MIPS_ROOTFS_FLOAT ?= $(if $(N64_USERLAND_FLOAT),$(N64_USERLAND_FLOAT),hard)
MIPS_ROOTFS_FLOATS = hard soft
ifneq ($(N64_USERLAND_FLOAT),)
ifneq ($(MIPS_ROOTFS_FLOAT),$(N64_USERLAND_FLOAT))
$(error MIPS_ROOTFS_FLOAT=$(MIPS_ROOTFS_FLOAT) conflicts with N64_USERLAND_FLOAT=$(N64_USERLAND_FLOAT))
endif
endif
ifeq ($(filter $(MIPS_ROOTFS_FLOAT),$(MIPS_ROOTFS_FLOATS)),)
$(error Unsupported MIPS_ROOTFS_FLOAT=$(MIPS_ROOTFS_FLOAT); expected one of $(MIPS_ROOTFS_FLOATS))
endif
MIPS_ROOTFS_ENDIAN ?= $(if $(N64_USERLAND_ENDIAN),$(N64_USERLAND_ENDIAN),big)
MIPS_ROOTFS_ENDIANS = big little
ifneq ($(N64_USERLAND_ENDIAN),)
ifneq ($(MIPS_ROOTFS_ENDIAN),$(N64_USERLAND_ENDIAN))
$(error MIPS_ROOTFS_ENDIAN=$(MIPS_ROOTFS_ENDIAN) conflicts with N64_USERLAND_ENDIAN=$(N64_USERLAND_ENDIAN))
endif
endif
ifeq ($(filter $(MIPS_ROOTFS_ENDIAN),$(MIPS_ROOTFS_ENDIANS)),)
$(error Unsupported MIPS_ROOTFS_ENDIAN=$(MIPS_ROOTFS_ENDIAN); expected one of $(MIPS_ROOTFS_ENDIANS))
endif
MIPS_ROOTFS_EXEC_FORMAT ?= $(if $(N64_USERLAND_EXEC_FORMAT),$(N64_USERLAND_EXEC_FORMAT),elf)
MIPS_ROOTFS_EXEC_FORMATS = aout elf
ifneq ($(N64_USERLAND_EXEC_FORMAT),)
ifneq ($(MIPS_ROOTFS_EXEC_FORMAT),$(N64_USERLAND_EXEC_FORMAT))
$(error MIPS_ROOTFS_EXEC_FORMAT=$(MIPS_ROOTFS_EXEC_FORMAT) conflicts with N64_USERLAND_EXEC_FORMAT=$(N64_USERLAND_EXEC_FORMAT))
endif
endif
ifeq ($(filter $(MIPS_ROOTFS_EXEC_FORMAT),$(MIPS_ROOTFS_EXEC_FORMATS)),)
$(error Unsupported MIPS_ROOTFS_EXEC_FORMAT=$(MIPS_ROOTFS_EXEC_FORMAT); expected one of $(MIPS_ROOTFS_EXEC_FORMATS))
endif
MIPS_ROOTFS_ABI = $(MIPS_ROOTFS_ENDIAN).$(MIPS_ROOTFS_CPU).$(MIPS_ROOTFS_FLOAT).$(MIPS_ROOTFS_EXEC_FORMAT)
KERNEL_COMPILER ?= gcc
KERNEL_COMPILERS = gcc pcc
ifeq ($(filter $(KERNEL_COMPILER),$(KERNEL_COMPILERS)),)
$(error Unsupported KERNEL_COMPILER=$(KERNEL_COMPILER); expected one of $(KERNEL_COMPILERS))
endif
MIPS_ROOTFS_COMMON_MANIFEST ?= $(TOPSRC)/sys/mips/rootfs.manifest
MIPS_ROOTFS_BOARD_MANIFEST ?= $(TOPSRC)/sys/mips/malta/rootfs.manifest
MIPS_ROOTFS_BUILD_MANIFEST = rootfs.generated.manifest
MIPS_ROOTFS_IMAGE_MANIFEST ?= $(MIPS_ROOTFS_BUILD_MANIFEST)
MIPS_ROOTFS_STAGE = rootfs.stage
MIPS_ROOTFS_STAMP = $(MIPS_ROOTFS_STAGE)/.stamp
MIPS_ROOTFS_COMMON_FILES = $(shell find $(TOPSRC)/sys/mips/rootfs \
                           -type f -o -type l 2>/dev/null)
MIPS_ROOTFS_OVERLAY_FILES =
MIPS_TRACE       ?= 0
VM_DIAGNOSTIC    ?= 0
FSUTIL          = $(OBJTOP)/tools/fsutil/fsutil
PCC_HOST_SMOKE_SCRIPT = $(TOPSRC)/sys/mips/n64/native/smoke-host-portablecc.sh
PCC_HOST_BUILD ?= $(TOPOBJ)/toolchain/pcc-build.$(MIPS_ROOTFS_ABI)
PCC_HOST_PREFIX ?= $(TOPOBJ)/toolchain/pcc-install.$(MIPS_ROOTFS_ABI)
PCC_HOST_TARGET = $(PCC_HOST_PREFIX)/mips-rebsd
PCC_HOST_LIB = $(PCC_HOST_TARGET)/lib
PCC_HOST_SOFTFLOAT_LIB = $(PCC_HOST_LIB)/softfloat
PCC_HOST_AS     = $(TOPSRC)/sys/mips/n64/n64-native-tools/as
PCC_HOST_LD     = $(TOPSRC)/sys/mips/n64/n64-native-tools/ld
PCC_HOST_AR     = $(TOPSRC)/sys/mips/n64/n64-native-tools/ar
PCC_HOST_PCC    = $(PCC_HOST_PREFIX)/bin/mips-rebsd-pcc
PCC_HOST_SRCS   = $(PCC_HOST_SMOKE_SCRIPT) \
                  $(shell find $(TOPSRC)/src/dev/pcc/pcc -type f \
                  \( -name '*.[chly]' -o -name '*.h' -o -name Makefile.in \
                  -o -name configure -o -name config.sub \
                  -o -name config.guess \) 2>/dev/null)
PCC_REGRESS_SCRIPT = $(TOPSRC)/sys/mips/tools/pcc-regress.py
PCC_REGRESS_OUT ?= $(TOPOBJ)/tests/pcc-regress
PCC_REGRESS_MANIFEST ?= $(TOPOBJ)/tests/pcc-regress.manifest
PCC_REGRESS_LOG ?= $(TOPOBJ)/tests/pcc-runtime.log
NATIVE_PCC_REGRESS_MANIFEST ?= $(TOPOBJ)/tests/native-pcc-regress.manifest
NATIVE_PCC_REGRESS_LOG ?= $(TOPOBJ)/tests/native-pcc-regress.log
NATIVE_PCC_REGRESS_TIMEOUT ?= 1200
NATIVE_PCC_REGRESS_SILENCE_TIMEOUT ?= 300
LINPACK_SMOKE_SCRIPT = $(TOPSRC)/sys/mips/tools/linpack-smoke.py
LINPACK_SMOKE_SRC = $(TOPSRC)/sys/mips/rootfs/root/linpack.c
LINPACK_SMOKE_OUT ?= $(TOPOBJ)/tests/linpack-smoke
LINPACK_SMOKE_MANIFEST ?= $(TOPOBJ)/tests/linpack-smoke.manifest
LINPACK_SMOKE_LOG ?= $(TOPOBJ)/tests/linpack-smoke.log
LINPACK_KERNEL_BENCH ?= 0
LINPACK_SMOKE_ARRAY_SIZE ?= 120
LINPACK_SMOKE_MIN_SECONDS ?= 1
PCC_ASM_COUNTER_SCRIPT = $(TOPSRC)/sys/mips/tools/mips-asm-counters.py
PCC_PERF_OUT ?= $(TOPOBJ)/tests/pcc-perf.$(MIPS_ROOTFS_ABI)
PCC_PERF_SOURCE ?= $(LINPACK_SMOKE_SRC)
PCC_PERF_NAME ?= linpack
PCC_SMOKE_ALL_LOG ?= $(TOPOBJ)/tests/pcc-smoke-all.$(MIPS_ROOTFS_ABI).log
PCC_SMOKE_ALL_TIMEOUT ?= 1800
PCC_SMOKE_ALL_SILENCE_TIMEOUT ?= 300
PCC_SMOKE_ALL_CCOM_STRESS_COUNT ?= 100
MALTA_RUN_COMMAND_SCRIPT = $(TOPSRC)/sys/mips/tools/malta-run-command.py
NATIVE_PCC_SMOKE_LOG ?= $(TOPOBJ)/tests/native-pcc-smoke.log
VM_SMOKE_LOG ?= $(TOPOBJ)/tests/vm-smoke.$(MIPS_ROOTFS_ABI).log
VM_STRESS_LOG ?= $(TOPOBJ)/tests/vm-stress.$(MIPS_ROOTFS_ABI).log
VM_PRESSURE_LOG ?= $(TOPOBJ)/tests/vm-pressure.$(MIPS_ROOTFS_ABI).log
VM_PRESSURE_ARGS ?= -s
VM_PRESSURE_SMOKE_DIR ?= \
    $(TOPOBJ)/tests/vm-pressure-smoke.$(USERLAND_COMPILER).$(MIPS_ROOTFS_ABI)
VM_PRESSURE_SMOKE_OBJ = $(VM_PRESSURE_SMOKE_DIR)/vm-pressure-smoke.o
VM_PRESSURE_SMOKE_LINKED = $(VM_PRESSURE_SMOKE_DIR)/vm-pressure-smoke.linked
VM_PRESSURE_SMOKE_BIN = $(VM_PRESSURE_SMOKE_DIR)/usr/bin/vm-pressure-smoke
VM_PRESSURE_SMOKE_PATCH_FILES = usr/bin/vm-pressure-smoke
VM_DIAGNOSTICS_PCC_DIR ?= \
    $(TOPOBJ)/tests/vm-diagnostics-pcc.$(MIPS_ROOTFS_ABI)
VM_DIAGNOSTICS_PCC_STRACE = \
    $(VM_DIAGNOSTICS_PCC_DIR)/usr/bin/strace-pcc
VM_DIAGNOSTICS_PCC_PRESSURE = \
    $(VM_DIAGNOSTICS_PCC_DIR)/usr/bin/vm-pressure-smoke-pcc
VM_DIAGNOSTICS_PCC_FILES = \
    usr/bin/strace-pcc usr/bin/vm-pressure-smoke-pcc
VM_DIAGNOSTICS_PCC_LOG ?= \
    $(TOPOBJ)/tests/vm-diagnostics-pcc.$(MIPS_ROOTFS_ABI).log
VM_DIAGNOSTICS_PCC_RUNTIME_DEPS = $(MIPS_NATIVE_DIR)/crt0.o \
    $(MIPS_NATIVE_DIR)/libc.a $(MIPS_NATIVE_DIR)/libpcc.a \
    $(if $(filter soft,$(MIPS_ROOTFS_FLOAT)),\
    $(MIPS_NATIVE_SOFTFLOAT_DIR)/libpcc.a,)
VM_DIAGNOSTICS_PCC_LDFLAGS = -nostartfiles \
    -T$(abspath $(MIPS_ROOTFS_USER_LDSCRIPT)) \
    $(abspath $(MIPS_NATIVE_DIR)/crt0.o) \
    $(if $(filter soft,$(MIPS_ROOTFS_FLOAT)),\
    -L$(abspath $(MIPS_NATIVE_SOFTFLOAT_DIR)),) \
    -L$(abspath $(MIPS_NATIVE_DIR))
VM_IO_SMOKE_LOG ?= $(TOPOBJ)/tests/vm-io-smoke.$(MIPS_ROOTFS_ABI).log
VM_NE2K_SMOKE_LOG ?= $(TOPOBJ)/tests/vm-ne2k-smoke.$(MIPS_ROOTFS_ABI).log
ROOTFS_BOOT_SMOKE_LOG ?= \
    $(TOPOBJ)/tests/rootfs-boot-smoke.$(MIPS_ROOTFS_PROFILE).$(MIPS_ROOTFS_ABI).log
ROOTFS_BOOT_SMOKE_COMMAND_full = /root/rootfs-boot-smoke.sh
ROOTFS_BOOT_SMOKE_EXPECT_full = rootfs boot smoke: ok
ROOTFS_BOOT_SMOKE_COMMAND_minimal = /root/libc-abi-smoke
ROOTFS_BOOT_SMOKE_EXPECT_minimal = libc abi smoke ok
ROOTFS_BOOT_SMOKE_COMMAND ?= \
    $(ROOTFS_BOOT_SMOKE_COMMAND_$(MIPS_ROOTFS_PROFILE))
ROOTFS_BOOT_SMOKE_EXPECT ?= \
    $(ROOTFS_BOOT_SMOKE_EXPECT_$(MIPS_ROOTFS_PROFILE))
ROOTFS_PROC_REAP_COMMAND_full = \
    for i in 1 2 3 4 5 6 7 8; do \
        for j in 1 2 3 4; do /bin/true || exit 1; done; \
    done; pstat -p
ROOTFS_PROC_REAP_EXPECT_full = active processes
ROOTFS_PROC_REAP_COMMAND_minimal = \
    for i in 1 2 3 4 5 6 7 8; do \
        for j in 1 2 3 4; do /bin/ls / >/dev/null || exit 1; done; \
    done; ps -x
ROOTFS_PROC_REAP_EXPECT_minimal = PID
ROOTFS_PROC_REAP_COMMAND ?= \
    $(ROOTFS_PROC_REAP_COMMAND_$(MIPS_ROOTFS_PROFILE))
ROOTFS_PROC_REAP_EXPECT ?= \
    $(ROOTFS_PROC_REAP_EXPECT_$(MIPS_ROOTFS_PROFILE))
VM_STRESS_ITERATIONS ?= 8
MIPS_ROOTFS_BOARD_DIR ?= $(TOPSRC)/sys/mips/malta/rootfs
MIPS_ROOTFS_BOARD_MANIFEST ?= $(TOPSRC)/sys/mips/malta/rootfs.manifest
MIPS_ROOTFS_TARGET_PLATFORM ?= mips
MIPS_ROOTFS_USERLAND_STAMP_PREFIX ?= mips-userland
MIPS_ROOTFS_ABI_VARIANT ?= $(MALTA_N64_8M_PROFILE)
MIPS_ROOTFS_EXTRA_CPPFLAGS ?= $(if $(MALTA_N64_8M_PROFILE),-DMALTA_N64_8M_PROFILE,)
MIPS_ROOTFS_USER_LDSCRIPT ?= mips-user.ld
MIPS_ROOTFS_USER_LDSCRIPT_SRC ?= $(TOPSRC)/sys/mips/user/user.ld.S
MIPS_PCC_HOST_BUILD ?= $(PCC_HOST_BUILD)
MIPS_PCC_HOST_PREFIX ?= $(PCC_HOST_PREFIX)
MIPS_LINPACK_SMOKE_OUT ?= $(LINPACK_SMOKE_OUT)
MIPS_LINPACK_SMOKE_MANIFEST ?= $(LINPACK_SMOKE_MANIFEST)
MIPS_ROOTFS_BOARD_MANIFEST_0775 ?= \
    $(if $(CI20_PORT),/usr/bin/fbset /usr/bin/fbview /usr/bin/lsusb,)
MIPS_ROOTFS_BOARD_CMD_CAT1_SOURCES ?= \
    $(if $(CI20_PORT),fbset:fbset fbview:fbview lsusb:lsusb,)

.DEFAULT_GOAL := all
include ../rootfs.mk

CPPFLAGS        = -I. -I$(TOPSRC)/include -I$(TOPSRC)/sys \
                  -I$(TOPSRC)/sys/mips/include \
                  ${PARAM} -DKERNEL -DMIPS \
                  $(MIPS_TARGET_ENDIAN_CFLAGS_$(MIPS_TARGET_ENDIAN)) \
                  $(if $(MALTA_N64_8M_PROFILE),-DMALTA_N64_8M_PROFILE,) \
                  -DMALTA_RAM_SIZE_OVERRIDE='($(MALTA_RAM_KBYTES) * 1024u)' \
                  -DMALTA_ROMDISK_BYTES_OVERRIDE='($(MIPS_ROOTFS_KBYTES) * 1024u)' \
                  $(if $(CI20_PORT),-DCI20_RAM_SIZE_OVERRIDE='($(CI20_RAM_KBYTES) * 1024u)' -DCI20_ROMDISK_BYTES_OVERRIDE='($(MIPS_ROOTFS_KBYTES) * 1024u)',) \
                  -DHW_MACHINE_NAME='"$(SYSTEM_TARGET)"' \
                  -DHW_MODEL_NAME='"$(MALTA_HW_MODEL)"'
ifneq ($(filter -DINET_ENABLED,$(PARAM)),)
CPPFLAGS        += -I$(TOPSRC)/include/sys \
                  -I$(TOPSRC)/sys/net \
                  -I$(TOPSRC)/sys/netinet -DINET -DSUPERVISOR
INET_CWARN      = -Wno-comment -Wno-endif-labels -Wno-implicit-int \
                  -Wno-implicit-function-declaration -Wno-parentheses \
                  -Wno-return-mismatch -Wno-return-type
endif
ifneq ($(filter -DUNIXDOMAIN_ENABLED,$(PARAM)),)
CPPFLAGS        += -DUNIXDOMAIN
endif
ifeq ($(MIPS_TRACE),1)
CPPFLAGS        += -DMIPS_TRACE
endif
ifeq ($(VM_DIAGNOSTIC),1)
CPPFLAGS        += -DVM_DIAGNOSTIC
endif
CFLAGS          = -O2 -Wall -Werror -Wno-array-bounds -nostdinc \
                  $(CPPFLAGS) $(INET_CWARN) -MT $@ -MP -MD -MF .deps/$*.dep
VERS_CFLAGS     = -O2 -Wall -Werror -Wno-array-bounds -nostdinc $(CPPFLAGS)
ASFLAGS         = -x assembler-with-cpp -c $(CPPFLAGS) -MT $@ -MP -MD \
                  -MF .deps/$*.dep
FPU_ASFLAGS     = $(ASFLAGS)

KERNEL_CC       = ${CC}
KERNEL_AS       = ${CC} -x assembler -c
KERNEL_COMPILER_DEPS =
COMPILE_C       = ${KERNEL_CC} ${CFLAGS} -c $<
COMPILE_VERS_C  = ${KERNEL_CC} ${VERS_CFLAGS} -MT vers.o -MP -MD \
                  -MF .deps/vers.dep -c vers.c -o vers.o
ifeq ($(KERNEL_COMPILER),pcc)
KERNEL_CC       = $(MIPS_PCC_CC) -march=$(MIPS_ROOTFS_CPU) -msoft-float \
                  -fomit-frame-pointer
KERNEL_COMPILER_DEPS = $(MIPS_PCC_PROVIDER_DEPS)
COMPILE_C       = ${KERNEL_CC} ${CFLAGS} -S -o .deps/$(@:.o=.s) $< && \
                  if grep -nE '^[[:space:]]*((add|sub|mul|div|sqrt|abs|mov|neg|cvt|trunc|round|floor|ceil|c\.[[:alnum:]_]+)\.(s|d|w|l)|(l|s)\.(s|d)|(lwc1|ldc1|swc1|sdc1|mfc1|mtc1|dmfc1|dmtc1|cfc1|ctc1|bc1[[:alnum:]_]*))[[:space:]]' .deps/$(@:.o=.s); then \
                      echo "error: PCC kernel C emitted COP1/FPU instructions in .deps/$(@:.o=.s)" >&2; exit 1; \
                  fi && \
                  ${KERNEL_AS} .deps/$(@:.o=.s) -o $@
COMPILE_VERS_C  = ${KERNEL_CC} ${VERS_CFLAGS} -MT vers.o -MP -MD \
                  -MF .deps/vers.dep -S -o .deps/vers.s vers.c && \
                  if grep -nE '^[[:space:]]*((add|sub|mul|div|sqrt|abs|mov|neg|cvt|trunc|round|floor|ceil|c\.[[:alnum:]_]+)\.(s|d|w|l)|(l|s)\.(s|d)|(lwc1|ldc1|swc1|sdc1|mfc1|mtc1|dmfc1|dmtc1|cfc1|ctc1|bc1[[:alnum:]_]*))[[:space:]]' .deps/vers.s; then \
                      echo "error: PCC kernel C emitted COP1/FPU instructions in .deps/vers.s" >&2; exit 1; \
                  fi && \
                  ${KERNEL_AS} .deps/vers.s -o vers.o
endif
SYSTEM_BUILD_USER ?= $(shell id -un 2>/dev/null || echo unknown)
SYSTEM_BUILD_HOST ?= $(shell hostname 2>/dev/null || uname -n 2>/dev/null || echo unknown)
SYSTEM_COMPILER_VERSION_gcc = $(shell $(firstword $(CC)) --version 2>/dev/null | sed -n '1p')
SYSTEM_COMPILER_VERSION_pcc = $(shell $(firstword $(MIPS_PCC_CC)) -v 2>&1 | sed -n '/Portable C Compiler/{p;q;}')
SYSTEM_COMPILER_VERSION = $(or $(SYSTEM_COMPILER_VERSION_$(KERNEL_COMPILER)),unknown)
SYSTEM_TOOLCHAIN_gcc = $(notdir $(firstword $(CC)))
SYSTEM_TOOLCHAIN_pcc = $(notdir $(firstword $(MIPS_PCC_CC)))
SYSTEM_TOOLCHAIN = $(or $(SYSTEM_TOOLCHAIN_$(KERNEL_COMPILER)),unknown)
SYSTEM_BUILD_NUMBER ?= $(or $(REBSD_BUILD_NUMBER),1)
SYSTEM_KERNEL_IDENT ?= GENERIC
SYSTEM_BUILD_DATE := $(or $(REBSD_BUILD_DATE),$(shell LC_ALL=C date '+%a %b %e %H:%M:%S %Z %Y'))
SYSTEM_GITREV := $(or $(shell git -C $(TOPSRC) rev-parse HEAD 2>/dev/null),unknown)
SYSTEM_GIT_BRANCH := $(or $(shell git -C $(TOPSRC) symbolic-ref --short -q HEAD 2>/dev/null),detached)
SYSTEM_GIT_DIRTY := $(shell test -n "$$(git -C $(TOPSRC) status --porcelain --untracked-files=normal 2>/dev/null)" && echo 1 || echo 0)
SYSTEM_TARGET = $(if $(filter little,$(MIPS_ROOTFS_ENDIAN)),mipsel,mips)
VERSION_GENERATOR = $(TOPSRC)/tools/build/gen-vers.py
GENERATE_VERS = python3 $(VERSION_GENERATOR) --output vers.c \
                  --version-header "$(TOPSRC)/sys/include/rebsd_version.h" \
                  --ident "$(SYSTEM_KERNEL_IDENT)" \
                  --build-number "$(SYSTEM_BUILD_NUMBER)" \
                  --build-date "$(SYSTEM_BUILD_DATE)" \
                  --compiler "$(KERNEL_COMPILER)" \
                  --build-user "$(SYSTEM_BUILD_USER)" \
                  --build-host "$(SYSTEM_BUILD_HOST)" \
                  --toolchain "$(SYSTEM_TOOLCHAIN)" \
                  --toolchain-version "$(SYSTEM_COMPILER_VERSION)" \
                  --git-rev "$(SYSTEM_GITREV)" \
                  --git-branch "$(SYSTEM_GIT_BRANCH)" \
                  --dirty "$(SYSTEM_GIT_DIRTY)" \
                  --target "$(SYSTEM_TARGET)" \
                  --cpu "$(MIPS_ROOTFS_CPU)" \
                  --fpu "$(MIPS_ROOTFS_FLOAT)" \
                  --byteorder "$(MIPS_ROOTFS_ENDIAN)"
COMPILE_S       = ${AS} ${ASFLAGS} $< -o $@
COMPILE_FPU_S   = ${AS} ${FPU_ASFLAGS} $< -o $@

%OBJS

%CFILES

include $(TOPSRC)/sys/mips/kernel-runtime.mk

MALTA_PROFILE_OBJS =
MALTA_BUILD_MODE_STAMP = .build-mode.$(KERNEL_COMPILER).$(MALTA_MEMORY_PROFILE).$(MALTA_RAM_KBYTES).$(CI20_RAM_KBYTES).$(MIPS_ROOTFS_KBYTES).$(MIPS_TRACE).$(VM_DIAGNOSTIC)
SYSTEM_OBJ      = ${OBJS} $(MALTA_PROFILE_OBJS) ioconf.o rootfs.o $(MIPS_KERNEL_RUNTIME_OBJS)
SYSTEM_DEP      = Makefile ioconf.c $(MALTA_KERNEL_LD_SCRIPT) \
                  $(TOPSRC)/sys/include/rebsd_version.h \
                  $(VERSION_GENERATOR) \
                  $(TOPSRC)/sys/disk/ramcomp.h \
                  $(KERNEL_COMPILER_DEPS) $(MIPS_KERNEL_RUNTIME_SRCS)
SYSTEM_LD_HEAD  = $(GENERATE_VERS); \
                  ${COMPILE_VERS_C}; \
                  rm -f $@
SYSTEM_LD       = ${LD} -nostdlib -T $(MALTA_KERNEL_LD_SCRIPT) ${SYSTEM_OBJ} vers.o -o $@
SYSTEM_LD_TAIL  = ${SIZE} $@; \
                  ${OBJDUMP} -d -S $@ > $(basename $@).dis; \
                  ${NM} -n $@ > $(basename $@).nm

.PHONY: vm-host-check kernel-objects
vm-host-check:
	$(MAKE) -C $(TOPSRC)/sys/tests/vm test

kernel-objects: $(filter-out rootfs.o,$(SYSTEM_OBJ)) swapunix.o

# Do not produce a kernel or filesystem image from an untested VM geometry.
# Order-only keeps an already valid image from being rebuilt just because the
# check itself is intentionally phony.
unix.elf rootfs.img: | vm-host-check

all: unix $(MALTA_EARLY_TARGET) $(if $(MALTA_PORT64),malta64.elf,)

kernel: unix $(if $(MALTA_PORT64),malta64.elf,)

ifneq ($(CI20_PORT),)
CI20_BINARY ?= ci20.bin
CI20_UIMAGE ?= ci20.uImage
CI20_UIMAGE_LOAD ?= 0x80100000
CI20_UIMAGE_ENTRY ?= 0x80100000
CI20_MKIMAGE ?= python3 $(TOPSRC)/sys/mips/tools/mkimage-legacy.py

all: $(CI20_UIMAGE)

kernel: $(CI20_UIMAGE)

$(CI20_BINARY): unix.elf
	$(OBJCOPY) -O binary unix.elf $@

$(CI20_UIMAGE): $(CI20_BINARY)
	$(CI20_MKIMAGE) -A mips -O linux -T kernel -C none \
	    -a $(CI20_UIMAGE_LOAD) -e $(CI20_UIMAGE_ENTRY) \
	    -n "ReBSD Ci20" -d $(CI20_BINARY) $@
endif

malta-early.o: $(TOPSRC)/sys/mips/malta/early_uart.S | .deps
	$(CC) $(ASFLAGS) $< -o $@

malta-early.elf: malta-early.o $(TOPSRC)/sys/mips/malta/malta.ld
	$(LD) -nostdlib -T $(TOPSRC)/sys/mips/malta/malta.ld malta-early.o -o $@
	$(SIZE) $@
	$(OBJDUMP) -d -S $@ > malta-early.dis

unix.bin: unix.elf
	$(OBJCOPY) -O binary --remove-section=.romdisk unix.elf unix.bin

malta64-stage0.o: $(MALTA64_SRC)/stage0.S $(MALTA_BUILD_MODE_STAMP) | .deps
	$(MALTA64_STAGE_CC) $(MALTA64_STAGE_ASFLAGS) $< -o $@

malta64-stage0-kernel.o: $(MALTA64_SRC)/stage0_kernel_blob.S unix.bin | .deps
	$(MALTA64_STAGE_CC) $(MALTA64_STAGE_ASFLAGS) $< -o $@

malta64-stage0-rootfs.o: $(MALTA64_SRC)/stage0_rootfs_blob.S rootfs.img | .deps
	$(MALTA64_STAGE_CC) $(MALTA64_STAGE_ASFLAGS) $< -o $@

malta64.elf: malta64-stage0.o malta64-stage0-kernel.o \
              malta64-stage0-rootfs.o $(MALTA64_STAGE_LD_SCRIPT)
	$(MALTA64_STAGE_LD) $(MALTA64_STAGE_LDFLAGS) \
	    -T $(MALTA64_STAGE_LD_SCRIPT) \
	    malta64-stage0.o malta64-stage0-kernel.o \
	    malta64-stage0-rootfs.o -o $@
	$(MALTA64_STAGE_SIZE) $@
	$(MALTA64_STAGE_OBJDUMP) -d -S $@ > malta64.dis

malta64-early.o: $(MALTA64_SRC)/early_uart64.S $(MALTA_BUILD_MODE_STAMP) | .deps
	$(MALTA64_STAGE_CC) $(MALTA64_STAGE_ASFLAGS) $< -o $@

malta64-early.elf: malta64-early.o $(MALTA64_STAGE_LD_SCRIPT)
	$(MALTA64_STAGE_LD) $(MALTA64_STAGE_LDFLAGS) \
	    -T $(MALTA64_STAGE_LD_SCRIPT) malta64-early.o -o $@
	$(MALTA64_STAGE_SIZE) $@
	$(MALTA64_STAGE_OBJDUMP) -d -S $@ > malta64-early.dis

run-early: $(MALTA_EARLY_TARGET)
	$(MALTA_QEMU) -M malta $(MALTA_QEMU_CPU_OPT) -m $(MALTA_QEMU_RAM) \
	    -nographic -serial mon:stdio -no-reboot -kernel $(MALTA_EARLY_TARGET)

run: $(MALTA_RUNTIME_KERNEL)
	$(MALTA_QEMU) -M malta $(MALTA_QEMU_CPU_OPT) -m $(MALTA_QEMU_RAM) \
	    -nographic -serial mon:stdio -no-reboot -kernel $(MALTA_RUNTIME_KERNEL)

run-vr4300: unix.elf
	$(MALTA_VR4300_QEMU) -M malta -cpu $(MALTA_VR4300_CPU) \
	    -m $(MALTA_QEMU_RAM) -nographic -serial mon:stdio \
	    -no-reboot -kernel unix.elf

run-net: $(MALTA_RUNTIME_KERNEL)
	$(MALTA_QEMU) -M malta $(MALTA_QEMU_CPU_OPT) -m $(MALTA_QEMU_RAM) \
	    -nographic -serial mon:stdio -no-reboot -kernel $(MALTA_RUNTIME_KERNEL) \
	    -netdev user,id=net0,guestfwd=tcp:10.0.2.100:2323-cmd:/bin/cat \
	    -device ne2k_isa,netdev=net0,iobase=0x300,irq=9,mac=52:54:00:12:34:56

.PHONY: smoke-host-portablecc pcc-regress-compile pcc-regress-stage \
        pcc-regress-runtime pcc-regress-runtime-vr4300 \
        pcc-regress-summary linpack-smoke-build \
        linpack-smoke-stage linpack-smoke-runtime \
        linpack-smoke-runtime-vr4300 native-pcc-smoke-runtime \
        native-pcc-smoke-runtime-vr4300 native-pcc-regress-stage \
        native-pcc-regress-runtime native-pcc-regress-runtime-vr4300 \
        pcc-perf-baseline pcc-smoke-all-runtime \
        pcc-smoke-all-runtime-vr4300 \
        vm-smoke-runtime vm-stress-runtime vm-pressure-runtime \
        vm-pressure-smoke-build vm-pressure-smoke-stage \
        vm-pressure-smoke-runtime \
        vm-diagnostics-pcc-runtime vm-io-smoke-runtime \
        vm-ne2k-smoke-runtime \
        rootfs-boot-smoke-runtime rootfs-halt-smoke-runtime \
        rootfs-patch rootfs-repack-kernel rootfs-patch-kernel FORCE

rootfs-boot-smoke-runtime: rootfs-contract-check \
    $(MALTA_RUN_COMMAND_SCRIPT)
	$(MAKE) $(MALTA_RUNTIME_KERNEL)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(ROOTFS_BOOT_SMOKE_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout 300 --silence-timeout 60 \
	    --require-login \
	    --command '$(ROOTFS_BOOT_SMOKE_COMMAND)' \
	    --expect "$(ROOTFS_BOOT_SMOKE_EXPECT)"
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(ROOTFS_BOOT_SMOKE_LOG).proc-reap \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout 300 --silence-timeout 60 \
	    --require-login \
	    --command '$(ROOTFS_PROC_REAP_COMMAND)' \
	    --expect "$(ROOTFS_PROC_REAP_EXPECT)"

rootfs-halt-smoke-runtime: rootfs-contract-check \
    $(MALTA_RUN_COMMAND_SCRIPT)
	$(MAKE) $(MALTA_RUNTIME_KERNEL)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(ROOTFS_BOOT_SMOKE_LOG).halt \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout 300 --silence-timeout 60 \
	    --require-login --terminal-expect \
	    --forbid-after-command 'login:' \
	    --forbid-after-command "CAUTION: some process(es) wouldn't die" \
	    --command halt --expect halted

vm-smoke-runtime: $(MIPS_ROOTFS_STAMP) $(MALTA_RUN_COMMAND_SCRIPT)
	$(MAKE) $(MALTA_RUNTIME_KERNEL)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(VM_SMOKE_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --command '/root/vm-process-smoke; echo VM_SMOKE_RC:$$?' \
	    --expect "VM_SMOKE_RC:0"

vm-stress-runtime: $(MIPS_ROOTFS_STAMP) $(MALTA_RUN_COMMAND_SCRIPT)
	$(MAKE) $(MALTA_RUNTIME_KERNEL)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(VM_STRESS_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout 900 --silence-timeout 180 \
	    --command 'VM_STRESS_ITERATIONS=$(VM_STRESS_ITERATIONS) /root/vm-stress-smoke.sh; echo VM_STRESS_RC:$$?' \
	    --expect "VM_STRESS_RC:0"

vm-pressure-runtime: $(MIPS_ROOTFS_STAMP) $(MALTA_RUN_COMMAND_SCRIPT)
	$(MAKE) $(MALTA_RUNTIME_KERNEL)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(VM_PRESSURE_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout 900 --silence-timeout 180 \
	    --command '/usr/bin/vm-pressure-smoke $(VM_PRESSURE_ARGS); echo VM_PRESSURE_RC:$$?' \
	    --expect "VM_PRESSURE_RC:0"

$(VM_PRESSURE_SMOKE_OBJ): $(TOPSRC)/src/cmd/vm-pressure-smoke.c \
    $(MIPS_USERLAND_CRT0_DEPS) $(MIPS_BUILD_SRC_DIR)/libc.a \
    $(MIPS_USERLAND_EXTRA_DEPS)
	mkdir -p $(dir $@)
	$(MIPS_USERLAND_CC) -O2 -c -o $@ $<

$(VM_PRESSURE_SMOKE_LINKED): $(VM_PRESSURE_SMOKE_OBJ) \
    $(MIPS_USERLAND_CRT0_DEPS) $(MIPS_BUILD_SRC_DIR)/libc.a
	$(MIPS_USERLAND_LD) $(MIPS_USERLAND_LDFLAGS) \
	    -o $@ $(VM_PRESSURE_SMOKE_OBJ) -lc

$(VM_PRESSURE_SMOKE_BIN): $(VM_PRESSURE_SMOKE_LINKED) \
    $(MIPS_ROOTFS_EXEC_FORMAT_DEPS)
	mkdir -p $(dir $@)
	$(MIPS_USERLAND_ELF2AOUT) $(VM_PRESSURE_SMOKE_LINKED) $@
	chmod 0775 $@

vm-pressure-smoke-build: $(VM_PRESSURE_SMOKE_BIN)

vm-pressure-smoke-stage: vm-pressure-smoke-build
	$(MAKE) rootfs-patch-kernel \
	    MIPS_ROOTFS_PATCH_DIR=$(abspath $(VM_PRESSURE_SMOKE_DIR)) \
	    MIPS_ROOTFS_PATCH_FILES="$(VM_PRESSURE_SMOKE_PATCH_FILES)"

vm-pressure-smoke-runtime: vm-pressure-smoke-stage \
    $(MALTA_RUN_COMMAND_SCRIPT)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(VM_PRESSURE_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout 900 --silence-timeout 180 \
	    --command '/usr/bin/vm-pressure-smoke $(VM_PRESSURE_ARGS); echo VM_PRESSURE_RC:$$?' \
	    --expect "VM_PRESSURE_RC:0"

$(VM_DIAGNOSTICS_PCC_STRACE): $(TOPSRC)/src/cmd/strace.c \
    $(MIPS_ROOTFS_STAMP) $(MIPS_PCC_PROVIDER_DEPS) \
    $(VM_DIAGNOSTICS_PCC_RUNTIME_DEPS)
	mkdir -p $(dir $@)
	$(MIPS_PCC_CC) -march=$(MIPS_ROOTFS_CPU) \
	    $(MIPS_ROOTFS_FLOAT_FLAG) $(MIPS_ROOTFS_TOOLCHAIN_CPP) \
	    $(MIPS_ROOTFS_EXTRA_CPPFLAGS) \
	    -I$(abspath $(MIPS_ROOTFS_USR_INCLUDE)) \
	    $(VM_DIAGNOSTICS_PCC_LDFLAGS) -o $@ $<

$(VM_DIAGNOSTICS_PCC_PRESSURE): $(TOPSRC)/src/cmd/vm-pressure-smoke.c \
    $(MIPS_ROOTFS_STAMP) $(MIPS_PCC_PROVIDER_DEPS) \
    $(VM_DIAGNOSTICS_PCC_RUNTIME_DEPS)
	mkdir -p $(dir $@)
	$(MIPS_PCC_CC) -march=$(MIPS_ROOTFS_CPU) \
	    $(MIPS_ROOTFS_FLOAT_FLAG) $(MIPS_ROOTFS_TOOLCHAIN_CPP) \
	    $(MIPS_ROOTFS_EXTRA_CPPFLAGS) \
	    -I$(abspath $(MIPS_ROOTFS_USR_INCLUDE)) \
	    $(VM_DIAGNOSTICS_PCC_LDFLAGS) -o $@ $<

vm-diagnostics-pcc-stage: $(VM_DIAGNOSTICS_PCC_STRACE) \
    $(VM_DIAGNOSTICS_PCC_PRESSURE)
	$(MAKE) rootfs-patch-kernel \
	    MIPS_ROOTFS_PATCH_DIR=$(abspath $(VM_DIAGNOSTICS_PCC_DIR)) \
	    MIPS_ROOTFS_PATCH_FILES="$(VM_DIAGNOSTICS_PCC_FILES)"

vm-diagnostics-pcc-runtime: vm-diagnostics-pcc-stage \
    $(MALTA_RUN_COMMAND_SCRIPT)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(VM_DIAGNOSTICS_PCC_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout 900 --silence-timeout 180 \
	    --command '/usr/bin/strace-pcc /bin/true && /usr/bin/vm-pressure-smoke-pcc $(VM_PRESSURE_ARGS); echo VM_DIAGNOSTICS_PCC_RC:$$?' \
	    --expect "VM_DIAGNOSTICS_PCC_RC:0"

vm-io-smoke-runtime: $(MIPS_ROOTFS_STAMP) $(MALTA_RUN_COMMAND_SCRIPT)
	$(MAKE) $(MALTA_RUNTIME_KERNEL)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(VM_IO_SMOKE_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout 600 --silence-timeout 180 \
	    --command '/root/net-smoke.sh && /root/usbn-smoke.sh && /root/fs-tools-smoke.sh; echo VM_IO_SMOKE_RC:$$?' \
	    --expect "VM_IO_SMOKE_RC:0"

vm-ne2k-smoke-runtime: $(MIPS_ROOTFS_STAMP) $(MALTA_RUN_COMMAND_SCRIPT)
	$(MAKE) $(MALTA_RUNTIME_KERNEL)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(VM_NE2K_SMOKE_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --qemu-arg=-netdev \
	    --qemu-arg=user,id=net0,guestfwd=tcp:10.0.2.100:2323-cmd:/bin/cat \
	    --qemu-arg=-device \
	    --qemu-arg=ne2k_isa,netdev=net0,iobase=0x300,irq=9,mac=52:54:00:12:34:56 \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout 600 --silence-timeout 180 \
	    --command '/root/ne2k-smoke.sh; echo VM_NE2K_SMOKE_RC:$$?' \
	    --expect "VM_NE2K_SMOKE_RC:0"

pcc-regress-compile: $(MIPS_ROOTFS_USER_STAMP) smoke-host-portablecc \
    $(PCC_REGRESS_SCRIPT)
	python3 $(PCC_REGRESS_SCRIPT) compile \
	    --pcc $(MIPS_PCC_CC) \
	    --rootfs $(abspath $(MIPS_ROOTFS_STAGE)) \
	    --out $(PCC_REGRESS_OUT) \
	    --ar $(MIPS_PCC_AR)

pcc-regress-stage: pcc-regress-compile $(MIPS_ROOTFS_BUILD_MANIFEST)
	python3 $(PCC_REGRESS_SCRIPT) stage \
	    --out $(PCC_REGRESS_OUT) \
	    --rootfs $(abspath $(MIPS_ROOTFS_STAGE)) \
	    --manifest $(abspath $(MIPS_ROOTFS_BUILD_MANIFEST)) \
	    --manifest-out $(PCC_REGRESS_MANIFEST)
	cp $(PCC_REGRESS_MANIFEST) $(MIPS_ROOTFS_BUILD_MANIFEST)

pcc-regress-runtime: pcc-regress-stage
	$(MAKE) $(MALTA_RUNTIME_KERNEL) \
	    MIPS_ROOTFS_IMAGE_MANIFEST=$(abspath $(PCC_REGRESS_MANIFEST))
	python3 $(PCC_REGRESS_SCRIPT) run \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(PCC_REGRESS_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM)

pcc-regress-runtime-vr4300:
	$(MAKE) pcc-regress-runtime \
	    MALTA_QEMU=$(MALTA_VR4300_QEMU) \
	    MALTA_QEMU_CPU=$(MALTA_VR4300_CPU) \
	    PCC_REGRESS_LOG=$(TOPOBJ)/tests/pcc-runtime-vr4300.log

pcc-regress-summary: $(PCC_REGRESS_SCRIPT)
	python3 $(PCC_REGRESS_SCRIPT) summarize \
	    --out $(PCC_REGRESS_OUT) \
	    --log $(PCC_REGRESS_LOG)

linpack-smoke-build: $(MIPS_LINPACK_ROOTFS_STAMP)
	@echo "linpack-smoke-build: ok"

linpack-smoke-stage: linpack-smoke-build $(MIPS_ROOTFS_BUILD_MANIFEST)
	python3 $(LINPACK_SMOKE_SCRIPT) stage \
	    --out $(LINPACK_SMOKE_OUT) \
	    --rootfs $(abspath $(MIPS_ROOTFS_STAGE)) \
	    --manifest $(abspath $(MIPS_ROOTFS_BUILD_MANIFEST)) \
	    --manifest-out $(LINPACK_SMOKE_MANIFEST)
	cp $(LINPACK_SMOKE_MANIFEST) $(MIPS_ROOTFS_BUILD_MANIFEST)

linpack-smoke-runtime: linpack-smoke-stage
	$(MAKE) $(MALTA_RUNTIME_KERNEL) \
	    MIPS_ROOTFS_IMAGE_MANIFEST=$(abspath $(LINPACK_SMOKE_MANIFEST))
	python3 $(LINPACK_SMOKE_SCRIPT) run \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(LINPACK_SMOKE_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --array-size $(LINPACK_SMOKE_ARRAY_SIZE) \
	    --min-seconds $(LINPACK_SMOKE_MIN_SECONDS) \
	    --kernel-bench $(LINPACK_KERNEL_BENCH)

linpack-smoke-runtime-vr4300:
	$(MAKE) linpack-smoke-runtime \
	    MALTA_QEMU=$(MALTA_VR4300_QEMU) \
	    MALTA_QEMU_CPU=$(MALTA_VR4300_CPU) \
	    LINPACK_SMOKE_LOG=$(TOPOBJ)/tests/linpack-smoke-vr4300.log

pcc-perf-baseline: $(MIPS_ROOTFS_USER_STAMP) smoke-host-portablecc \
    $(PCC_ASM_COUNTER_SCRIPT)
	rm -rf $(PCC_PERF_OUT)
	mkdir -p $(PCC_PERF_OUT)
	$(MIPS_ROOTFS_GCC_PREFIX)gcc $(MIPS_ROOTFS_ARCH) $(MIPS_ROOTFS_CODE) \
	    $(MIPS_ROOTFS_TOOLCHAIN_CPP) $(MIPS_ROOTFS_EXTRA_CPPFLAGS) \
	    -I$(abspath $(MIPS_ROOTFS_USR_INCLUDE)) \
	    -O2 -S -o $(PCC_PERF_OUT)/$(PCC_PERF_NAME)-gcc.s \
	    $(PCC_PERF_SOURCE)
	$(MIPS_PCC_CC) -march=$(MIPS_ROOTFS_CPU) $(MIPS_ROOTFS_FLOAT_FLAG) \
	    $(MIPS_ROOTFS_TOOLCHAIN_CPP) $(MIPS_ROOTFS_EXTRA_CPPFLAGS) \
	    -I$(abspath $(MIPS_ROOTFS_USR_INCLUDE)) \
	    -O2 -S -o $(PCC_PERF_OUT)/$(PCC_PERF_NAME)-pcc.s \
	    $(PCC_PERF_SOURCE)
	python3 $(PCC_ASM_COUNTER_SCRIPT) \
	    --metadata board=$(notdir $(abspath .)) \
	    --metadata cpu=$(MIPS_ROOTFS_CPU) \
	    --metadata endian=$(MIPS_ROOTFS_ENDIAN) \
	    --metadata float=$(MIPS_ROOTFS_FLOAT) \
	    --metadata exec=$(MIPS_ROOTFS_EXEC_FORMAT) \
	    --out $(PCC_PERF_OUT)/$(PCC_PERF_NAME)-asm-summary.json \
	    --input gcc=$(PCC_PERF_OUT)/$(PCC_PERF_NAME)-gcc.s \
	    --input pcc=$(PCC_PERF_OUT)/$(PCC_PERF_NAME)-pcc.s

pcc-smoke-all-runtime: $(MIPS_ROOTFS_STAMP) $(MALTA_RUN_COMMAND_SCRIPT)
	$(MAKE) $(MALTA_RUNTIME_KERNEL)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(PCC_SMOKE_ALL_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout $(PCC_SMOKE_ALL_TIMEOUT) \
	    --silence-timeout $(PCC_SMOKE_ALL_SILENCE_TIMEOUT) \
	    --command 'CCOM_STRESS_COUNT=$(PCC_SMOKE_ALL_CCOM_STRESS_COUNT) LINPACK_ARRAY_SIZE=$(LINPACK_SMOKE_ARRAY_SIZE) LINPACK_MIN_SECONDS=$(LINPACK_SMOKE_MIN_SECONDS) /root/pcc-smoke-all.sh; echo PCC_SMOKE_ALL_RC:$$?' \
	    --expect "PCC_SMOKE_ALL_RC:0"

pcc-smoke-all-runtime-vr4300:
	$(MAKE) pcc-smoke-all-runtime \
	    MALTA_QEMU=$(MALTA_VR4300_QEMU) \
	    MALTA_QEMU_CPU=$(MALTA_VR4300_CPU) \
	    PCC_SMOKE_ALL_LOG=$(TOPOBJ)/tests/pcc-smoke-all-vr4300.log

native-pcc-smoke-runtime: $(MIPS_ROOTFS_STAMP) $(MALTA_RUN_COMMAND_SCRIPT)
	$(MAKE) $(MALTA_RUNTIME_KERNEL)
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(NATIVE_PCC_SMOKE_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --command '/root/native-pcc-smoke.sh && /root/libc-abi-smoke.sh && /root/build-workload-smoke.sh; echo NATIVE_PCC_SMOKE_RC:$$?' \
	    --expect "NATIVE_PCC_SMOKE_RC:0"

native-pcc-smoke-runtime-vr4300:
	$(MAKE) native-pcc-smoke-runtime \
	    MALTA_QEMU=$(MALTA_VR4300_QEMU) \
	    MALTA_QEMU_CPU=$(MALTA_VR4300_CPU) \
	    NATIVE_PCC_SMOKE_LOG=$(TOPOBJ)/tests/native-pcc-smoke-vr4300.log

native-pcc-regress-stage: $(MIPS_ROOTFS_BUILD_MANIFEST) $(PCC_REGRESS_SCRIPT)
	python3 $(PCC_REGRESS_SCRIPT) native-stage \
	    --rootfs $(abspath $(MIPS_ROOTFS_STAGE)) \
	    --manifest $(abspath $(MIPS_ROOTFS_BUILD_MANIFEST)) \
	    --manifest-out $(NATIVE_PCC_REGRESS_MANIFEST)
	cp $(NATIVE_PCC_REGRESS_MANIFEST) $(MIPS_ROOTFS_BUILD_MANIFEST)

native-pcc-regress-runtime: native-pcc-regress-stage $(MALTA_RUN_COMMAND_SCRIPT)
	$(MAKE) $(MALTA_RUNTIME_KERNEL) \
	    MIPS_ROOTFS_IMAGE_MANIFEST=$(abspath $(NATIVE_PCC_REGRESS_MANIFEST))
	python3 $(MALTA_RUN_COMMAND_SCRIPT) \
	    --malta-dir $(abspath .) \
	    --kernel $(MALTA_RUNTIME_KERNEL) \
	    --log $(NATIVE_PCC_REGRESS_LOG) \
	    --qemu $(MALTA_QEMU) $(MALTA_QEMU_CPU_ARG) \
	    --ram $(MALTA_QEMU_RAM) \
	    --timeout $(NATIVE_PCC_REGRESS_TIMEOUT) \
	    --silence-timeout $(NATIVE_PCC_REGRESS_SILENCE_TIMEOUT) \
	    --command '/root/run-native-pcc-regress.sh; echo NATIVE_PCC_REGRESS_RC:$$?' \
	    --expect "NATIVE_PCC_REGRESS_RC:0"

native-pcc-regress-runtime-vr4300:
	$(MAKE) native-pcc-regress-runtime \
	    MALTA_QEMU=$(MALTA_VR4300_QEMU) \
	    MALTA_QEMU_CPU=$(MALTA_VR4300_CPU) \
	    NATIVE_PCC_REGRESS_LOG=$(TOPOBJ)/tests/native-pcc-regress-vr4300.log

FORCE:

MIPS_ROOTFS_PATCH_DIR ?= $(TOPOBJ)/tests/rootfs-patch
MIPS_ROOTFS_PATCH_FILES ?=
MIPS_ROOTFS_PATCH_MANIFEST ?= rootfs.patch.manifest
MIPS_ROOTFS_PATCH_SCRIPT = $(TOPSRC)/sys/mips/tools/rootfs-patch.py

rootfs-patch: $(FSUTIL) $(MIPS_ROOTFS_PATCH_SCRIPT)
	@if [ -z "$(MIPS_ROOTFS_PATCH_FILES)" ]; then \
	    echo "Set MIPS_ROOTFS_PATCH_FILES to paths under MIPS_ROOTFS_PATCH_DIR"; \
	    exit 2; \
	fi
	@if [ ! -d $(MIPS_ROOTFS_STAGE) ] || [ ! -f $(MIPS_ROOTFS_IMAGE_MANIFEST) ]; then \
	    echo "rootfs stage/manifest is missing; build the rootfs once before using rootfs-patch"; \
	    exit 2; \
	fi
	python3 $(MIPS_ROOTFS_PATCH_SCRIPT) \
	    --rootfs $(abspath $(MIPS_ROOTFS_STAGE)) \
	    --manifest $(abspath $(MIPS_ROOTFS_IMAGE_MANIFEST)) \
	    --manifest-out $(abspath $(MIPS_ROOTFS_PATCH_MANIFEST)) \
	    --patch-dir $(abspath $(MIPS_ROOTFS_PATCH_DIR)) \
	    $(MIPS_ROOTFS_PATCH_FILES)
	rm -f rootfs.img
	$(FSUTIL) --new --endian=$(MIPS_ROOTFS_ENDIAN) \
	    --size=$(MIPS_ROOTFS_KBYTES) \
	    --manifest=$(MIPS_ROOTFS_PATCH_MANIFEST) rootfs.img $(MIPS_ROOTFS_STAGE)
	$(FSUTIL) --check rootfs.img

rootfs-repack-kernel:
	@if [ ! -f rootfs.img ]; then \
	    echo "rootfs.img is missing; build the rootfs once before using rootfs-repack-kernel"; \
	    exit 2; \
	fi
	$(LD) -r -b binary -o rootfs.o rootfs.img
	$(OBJCOPY) --rename-section .data=.romdisk,alloc,load,readonly,data,contents rootfs.o
	$(GENERATE_VERS)
	${COMPILE_VERS_C}
	rm -f unix.elf
	${LD} -nostdlib -T $(MALTA_KERNEL_LD_SCRIPT) ${SYSTEM_OBJ} vers.o -o unix.elf swapunix.o
	${SIZE} unix.elf
	${OBJDUMP} -d -S unix.elf > unix.dis
	${NM} -n unix.elf > unix.nm
ifneq ($(MALTA_PORT64),)
	$(OBJCOPY) -O binary --remove-section=.romdisk unix.elf unix.bin
	$(MALTA64_STAGE_CC) $(MALTA64_STAGE_ASFLAGS) \
	    $(MALTA64_SRC)/stage0_kernel_blob.S -o malta64-stage0-kernel.o
	$(MALTA64_STAGE_CC) $(MALTA64_STAGE_ASFLAGS) \
	    $(MALTA64_SRC)/stage0_rootfs_blob.S -o malta64-stage0-rootfs.o
	$(MALTA64_STAGE_LD) $(MALTA64_STAGE_LDFLAGS) \
	    -T $(MALTA64_STAGE_LD_SCRIPT) \
	    malta64-stage0.o malta64-stage0-kernel.o \
	    malta64-stage0-rootfs.o -o malta64.elf
	$(MALTA64_STAGE_SIZE) malta64.elf
	$(MALTA64_STAGE_OBJDUMP) -d -S malta64.elf > malta64.dis
endif

rootfs-patch-kernel: rootfs-patch
	$(MAKE) rootfs-repack-kernel

$(MALTA_BUILD_MODE_STAMP):
	rm -f .build-mode.*
	touch $@

ioconf.o: ioconf.c ${SYSTEM_DEP} | machine sys .deps
	${COMPILE_C}

${SYSTEM_OBJ} swapunix.o: | machine sys .deps
$(filter-out rootfs.o,$(SYSTEM_OBJ)) swapunix.o: $(MALTA_BUILD_MODE_STAMP)

$(FSUTIL):
	$(MAKE) -C $(TOPSRC)/tools/fsutil

$(OBJTOP)/tools/kconfig/kconfig:
	$(MAKE) -C $(TOPSRC)/tools/kconfig

reconfig ioconf.c swapunix.c: $(TOPSRC)/sys/mips/$(notdir $(CURDIR))/Config $(OBJTOP)/tools/kconfig/kconfig | machine sys
	$(OBJTOP)/tools/kconfig/kconfig $<

MIPS_MACHINE_LINK_TARGET ?= $(TOPSRC)/sys/mips

.PHONY: machine sys
machine:
	ln -sfn $(MIPS_MACHINE_LINK_TARGET) $@

sys:
	ln -sfn $(TOPSRC)/sys/include $@

clean clean-all: mips-rootfs-clean
	rm -rf *.o *.elf *.bin *.img *.dis *.nm a.out .deps machine sys \
	    vers.c .build-mode.*

.deps:
	mkdir -p .deps

%LOAD

%RULES

-include .deps/*.dep
