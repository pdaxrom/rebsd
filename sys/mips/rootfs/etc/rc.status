#!/bin/sh
# Common System V boot-status output used by every ReBSD platform.

rc_start()
{
	echo -n "Starting $1 ... "
}

rc_stop()
{
	echo -n "Stopping $1 ... "
}

rc_result()
{
	rc_status=$1
	if test "$rc_status" -eq 0; then
		echo '[ OK ]'
	else
		echo '[FAILED]'
	fi
	return "$rc_status"
}

rc_run()
{
	rc_description=$1
	shift
	rc_start "$rc_description"
	"$@"
	rc_status=$?
	rc_result "$rc_status"
	return "$rc_status"
}
