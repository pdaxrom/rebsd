#
# MIPS Creator Ci20 / Ingenic JZ4780.
#
architecture    "mips"
cpu             "MIPS32"
board           "CI20"

makeoptions     MIPS_TOOLCHAIN="/Users/sash/Library/mipsel-toolchain",
                MIPS_PREFIX="/Users/sash/Library/mipsel-toolchain/bin/mipsel-elf-",
                MIPS_ROOTFS_ENDIAN=little,
                MIPS_TARGET_ENDIAN=little,
                MIPS_ROOTFS_COMPILER=gcc,
                MIPS_KERNEL_COMPILER=gcc,
                MIPS_MACHINE_LINK_TARGET="$(TOPSRC)/sys/mips/ci20",
                MIPS_ROOTFS_BOARD_DIR="$(TOPSRC)/sys/mips/ci20/rootfs",
                MIPS_ROOTFS_BOARD_MANIFEST="$(TOPSRC)/sys/mips/ci20/rootfs.manifest",
                MIPS_BOARD_MACHINE_HEADER_DIR="$(TOPSRC)/sys/mips/ci20",
                MIPS_COMMON_MACHINE_HEADERS="cpu elf_machdep float fpu io limits",
                MIPS_BOARD_CMD_SUBDIRS="fbset fbview",
                MIPS_BOARD_USR_BIN_FILES="fbset fbview",
                MIPS_STB_DIR="/Users/sash/Work/N64/N64cart/rom/src/stb",
                MALTA_KERNEL_LD_SCRIPT="$(TOPSRC)/sys/mips/ci20/ci20.ld",
                MALTA_VERSION_NAME="Ci20",
                MALTA_HW_MODEL="MIPS Creator Ci20 / Ingenic JZ4780"

options         "CONS_MAJOR=0", "CONS_MINOR=0"
options         "VIDEO_ENABLED"

device          "ci20_uart"

service         creator
service         dma
service         disk
service         fat
service         usb
service         ukbd
service         umass
service         uhub
service         ehci
service         ohci
service         ether   1
service         "ci20_dm9000"
service         inet
service         unixdomain

config          unix    root on major 0 minor 0
                        swap on major 1 minor 0
