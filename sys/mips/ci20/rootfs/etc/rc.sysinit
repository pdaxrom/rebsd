#!/bin/sh
HOME=/; export HOME
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH
PAGER=/bin/cat; export PAGER
. /etc/rc.status
. /etc/rc.storage

if ! rc_run 'hostname' /bin/hostname ci20; then
	exit 1
fi

if ! rc_var_setup /dev/ram0 1M 4096; then
	exit 1
fi

if ! rc_compressed_swap_setup /dev/ram1 32M 2x; then
	exit 1
fi

exit 0
