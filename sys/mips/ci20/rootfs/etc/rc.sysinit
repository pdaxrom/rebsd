#!/bin/sh
HOME=/; export HOME
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH
PAGER=/bin/cat; export PAGER

/bin/hostname ci20

/usr/sbin/ramctl create /dev/ram0 size=1M >/dev/null 2>&1
if /sbin/mount /var >/dev/null 2>&1; then
        :
else
        /sbin/mkfs /dev/ram0 >/dev/null 2>&1
        /sbin/mount /var >/dev/null 2>&1
fi

mkdir /var/config /var/db /var/log /var/run /var/tmp /var/lock 2>/dev/null
chmod 1777 /var/tmp
: >/var/run/utmp
: >/var/log/wtmp
chmod 664 /var/run/utmp /var/log/wtmp

if /usr/sbin/ramctl create /dev/ram1 backing=32M size=2x compression \
    >/dev/null 2>&1; then
        if /usr/sbin/mkswap /dev/ram1 >/dev/null 2>&1; then
                /usr/sbin/swapon /dev/ram1
        fi
fi

exit 0
