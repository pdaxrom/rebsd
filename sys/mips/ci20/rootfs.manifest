#
# Ci20 first-boot rootfs additions.  Shared MIPS userland layout comes from
# sys/mips/rootfs.manifest; this file only describes Ci20 device nodes.
#

bdev /dev/romdisk
major 0
minor 0

bdev /dev/swap
major 1
minor 0

bdev /dev/ram0
major 1
minor 1

bdev /dev/sd0
major 2
minor 0

bdev /dev/sd0a
major 2
minor 1

bdev /dev/sd0b
major 2
minor 2

bdev /dev/sd0c
major 2
minor 3

bdev /dev/sd0d
major 2
minor 4

bdev /dev/sd1
major 2
minor 5

bdev /dev/sd1a
major 2
minor 6

bdev /dev/sd1b
major 2
minor 7

bdev /dev/sd1c
major 2
minor 8

bdev /dev/sd1d
major 2
minor 9

bdev /dev/sd2
major 2
minor 10

bdev /dev/sd2a
major 2
minor 11

bdev /dev/sd2b
major 2
minor 12

bdev /dev/sd2c
major 2
minor 13

bdev /dev/sd2d
major 2
minor 14

bdev /dev/sd3
major 2
minor 15

bdev /dev/sd3a
major 2
minor 16

bdev /dev/sd3b
major 2
minor 17

bdev /dev/sd3c
major 2
minor 18

bdev /dev/sd3d
major 2
minor 19

cdev /dev/console
major 0
minor 0

cdev /dev/mem
major 1
minor 0
mode 0640

cdev /dev/kmem
major 1
minor 1
mode 0640

cdev /dev/null
major 1
minor 2
mode 0666

cdev /dev/zero
major 1
minor 3
mode 0666

cdev /dev/tty
major 2
minor 0

cdev /dev/ttyS0
major 3
minor 0
