index 7cf614a..13bfd50 100644
--- a/src/target/mips32_pracc.c
+++ b/src/target/mips32_pracc.c
@@ -1109,6 +1109,34 @@ int mips32_pracc_read_regs(struct mips_ejtag *ejtag_info, uint32_t *regs)
 	return ctx.retval;
 }
 
+/*
+ * XBurst1 may retain a branch target for the EJTAG debug segment between
+ * separate PrAcc programs.  Disable and invalidate its BTB before any of
+ * the normal context-access programs execute.  DeSave is the architectural
+ * EJTAG scratch register, so this sequence preserves the stopped CPU's GPRs.
+ */
+int mips32_pracc_disable_xburst1_btb(struct mips_ejtag *ejtag_info)
+{
+	struct pracc_queue_info ctx;
+	pracc_queue_init(&ctx);
+
+	pracc_add(&ctx, 0, MIPS32_MTC0(1, 31, 0));		/* save $1 in DeSave */
+	pracc_add(&ctx, 0, MIPS32_MFC0(1, 16, 7));		/* read Config7 */
+	pracc_add(&ctx, 0, MIPS32_ANDI(1, 1, 0xfffe));	/* clear BTBE */
+	pracc_add(&ctx, 0, MIPS32_ORI(1, 1, 0x0002));	/* set BTBV */
+	pracc_add(&ctx, 0, MIPS32_MTC0(1, 16, 7));		/* write Config7 */
+	pracc_add(&ctx, 0, MIPS32_NOP);
+	pracc_add(&ctx, 0, MIPS32_NOP);
+	pracc_add(&ctx, 0, MIPS32_NOP);
+	pracc_add(&ctx, 0, MIPS32_MFC0(1, 31, 0));		/* restore $1 */
+	pracc_add(&ctx, 0, MIPS32_B(NEG16(ctx.code_count + 1)));
+	pracc_add(&ctx, 0, MIPS32_NOP);
+
+	ctx.retval = mips32_pracc_queue_exec(ejtag_info, &ctx, NULL);
+	pracc_queue_free(&ctx);
+	return ctx.retval;
+}
